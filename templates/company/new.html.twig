{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'company.new.title'|trans({}, 'companies') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-3xl mx-auto space-y-8">

    {# Breadcrumb #}
    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
            <a href="{{ path('app_companies_index') }}" class="hover:text-plum-600 transition-colors">
                {{ 'companies.title'|trans({}, 'companies') }}
            </a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'company.new.title'|trans({}, 'companies') }}</h1>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <form method="post" class="px-6 py-6 space-y-5">
            <input type="hidden" name="_token" value="{{ csrf_token('new_company') }}">

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">

                {# Nombre #}
                <div class="sm:col-span-2">
                    <twig:Form:Field
                        id="name"
                        name="name"
                        label="{{ 'company.field.name'|trans({}, 'companies') }}"
                        value="{{ values.name }}"
                        :error="errors.name ?? null"
                    />
                </div>

                {# CIF/NIF #}
                <div>
                    <twig:Form:Field
                        id="vat_number"
                        name="vat_number"
                        label="{{ 'company.field.vat_number'|trans({}, 'companies') }}"
                        value="{{ values.vat_number }}"
                        :error="errors.vat_number ?? null"
                        :mono="true"
                    />
                </div>

                {# Localidad #}
                <div class="sm:col-span-3">
                    <twig:Form:Field
                        id="city"
                        name="city"
                        label="{{ 'company.field.city'|trans({}, 'companies') }}"
                        value="{{ values.city }}"
                        :error="errors.city ?? null"
                    />
                </div>

            </div>

            {# Representante de la empresa #}
            <div class="pt-3 border-t border-gray-100">
                <label class="block text-sm font-medium text-gray-700 mb-0.5">
                    {{ 'company.representative.label'|trans({}, 'companies') }}
                </label>
                <p class="text-xs text-gray-400 mb-2">{{ 'company.representative.help'|trans({}, 'companies') }}</p>
                <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
                    <div>
                        <twig:Form:Field
                            id="representative_first_name"
                            name="representative_first_name"
                            label="{{ 'company.field.representative_first_name'|trans({}, 'companies') }}"
                            value="{{ values.representative_first_name }}"
                            :error="errors.representativeFirstName ?? null"
                        />
                    </div>
                    <div class="sm:col-span-2">
                        <twig:Form:Field
                            id="representative_last_name"
                            name="representative_last_name"
                            label="{{ 'company.field.representative_last_name'|trans({}, 'companies') }}"
                            value="{{ values.representative_last_name }}"
                            :error="errors.representativeLastName ?? null"
                        />
                    </div>
                    <div>
                        <twig:Form:Field
                            id="representative_national_id"
                            name="representative_national_id"
                            label="{{ 'company.field.representative_national_id'|trans({}, 'companies') }}"
                            value="{{ values.representative_national_id }}"
                            :error="errors.representativeNationalId ?? null"
                            :mono="true"
                        />
                    </div>
                    <div class="sm:col-span-2">
                        <twig:Form:Field
                            id="representative_role"
                            name="representative_role"
                            label="{{ 'company.field.representative_role'|trans({}, 'companies') }}"
                            value="{{ values.representative_role }}"
                            :error="errors.representativeRole ?? null"
                        />
                    </div>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-2">
                <a href="{{ path('app_companies_index') }}"
                   class="rounded-xl border border-gray-200 px-4 py-2.5 text-sm font-medium text-gray-700
                          hover:bg-gray-50 transition-colors">
                    {{ 'company.cancel'|trans({}, 'companies') }}
                </a>
                <button type="submit"
                        class="rounded-xl bg-plum-600 px-4 py-2.5 text-sm font-semibold text-white
                               hover:bg-plum-700 transition-colors shadow-xs">
                    {{ 'company.save'|trans({}, 'companies') }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
