{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'companies.import.title'|trans({}, 'companies') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-2xl mx-auto space-y-8">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            <a href="{{ path('app_companies_index') }}" class="hover:text-plum-600 transition-colors">{{ 'companies.title'|trans({}, 'companies') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'companies.import.title'|trans({}, 'companies') }}</h1>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <form method="post" enctype="multipart/form-data" data-controller="form-submit" class="px-6 py-6 space-y-6">
            <input type="hidden" name="_token" value="{{ csrf_token('import_companies') }}">

            <div class="rounded-xl bg-blue-50 border border-blue-200 px-4 py-3.5 text-sm text-blue-700 space-y-1">
                <p class="font-medium">{{ 'companies.import.help.title'|trans({}, 'companies') }}</p>
                <ul class="list-disc list-inside space-y-0.5 text-blue-600 text-xs mt-1">
                    <li>{{ 'companies.import.help.template'|trans({}, 'companies') }}</li>
                    <li>{{ 'companies.import.help.sheets'|trans({}, 'companies') }}</li>
                    <li>{{ 'companies.import.help.match'|trans({}, 'companies') }}</li>
                    <li>{{ 'companies.import.help.empty'|trans({}, 'companies') }}</li>
                    <li>{{ 'companies.import.help.no_delete'|trans({}, 'companies') }}</li>
                    <li>{{ 'companies.import.help.all_or_nothing'|trans({}, 'companies') }}</li>
                </ul>
                <p class="pt-2">
                    <a href="{{ path('app_companies_template') }}" class="inline-flex items-center gap-1.5 text-xs font-medium text-blue-700 underline hover:text-blue-900">
                        {{ ux_icon('heroicons:arrow-down-tray', {class: 'h-3.5 w-3.5'}) }}
                        {{ 'companies.import.download_template'|trans({}, 'companies') }}
                    </a>
                </p>
            </div>

            {% if notice is defined and notice %}
            <div class="rounded-xl bg-amber-50 border border-amber-200 px-4 py-3.5 text-sm text-amber-700" role="status">
                {{ notice }}
            </div>
            {% endif %}

            {% if errors is defined and errors|length > 0 %}
            <div class="rounded-xl bg-red-50 border border-red-200 px-4 py-3.5 text-sm text-red-700" role="alert">
                <p class="font-medium">{{ 'companies.import.errors.title'|trans({}, 'companies') }}</p>
                <ul class="list-disc list-inside space-y-0.5 text-xs mt-1">
                    {% for error in errors %}
                    <li>{{ error }}</li>
                    {% endfor %}
                </ul>
            </div>
            {% endif %}

            <div>
                <label for="xlsx"
                       class="flex flex-col items-center justify-center gap-3 w-full rounded-xl border-2 border-dashed
                              border-gray-300 bg-gray-50 px-6 py-8 cursor-pointer
                              hover:border-plum-400 hover:bg-plum-50/40 transition-colors group mt-4 mb-2">
                    {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-8 w-8 text-gray-400 group-hover:text-plum-500 transition-colors'}) }}
                    <span class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2
                                 text-sm font-medium text-gray-700 shadow-xs group-hover:border-plum-300 group-hover:text-plum-700 transition-colors">
                        {{ 'companies.import.choose_file'|trans({}, 'companies') }}
                    </span>
                    <span id="xlsx-filename" class="text-xs text-gray-400">
                        {{ 'companies.import.no_file_chosen'|trans({}, 'companies') }}
                    </span>
                </label>
                <input type="file" id="xlsx" name="xlsx"
                       accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
                       class="sr-only hidden"
                       onchange="document.getElementById('xlsx-filename').textContent = this.files[0]?.name ?? '{{ 'companies.import.no_file_chosen'|trans({}, 'companies')|e('js') }}'">
            </div>

            <div class="flex items-center justify-between pt-2">
                <a href="{{ path('app_companies_index') }}" class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
                    {{ 'companies.import.cancel'|trans({}, 'companies') }}
                </a>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-xl bg-plum-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-plum-700 transition-colors shadow-xs">
                    {{ ux_icon('heroicons:arrow-up-tray', {class: 'h-4 w-4'}) }}
                    {{ 'companies.import.submit'|trans({}, 'companies') }}
                </button>
            </div>
        </form>
    </div>

</div>
{% endblock %}
