{# Diferencia entre los estudiantes que debería tener un docente y los que tiene asignados. #}
{% macro balance(expected, assigned) %}
    {% if assigned == expected %}
        <span class="text-green-700">{{ 'stays.teachers.complete'|trans({}, 'stays') }}</span>
    {% elseif assigned < expected %}
        <span class="text-amber-700">{{ 'stays.teachers.missing'|trans({'%count%': expected - assigned}, 'stays') }}</span>
    {% else %}
        <span class="text-red-600">{{ 'stays.teachers.extra'|trans({'%count%': assigned - expected}, 'stays') }}</span>
    {% endif %}
{% endmacro %}


{%- set d                              = this.getData() -%}
{%- set stay                           = d.stay -%}
{%- set can_manage                     = d.can_manage -%}
{%- set can_delete                     = d.can_delete -%}
{%- set manageable_student_ids        = d.manageable_student_ids -%}
{%- set multi_programme               = stay.programmes|length > 1 -%}
{%- set can_add_position               = d.can_add_position -%}
{%- set can_view_unassigned            = d.can_view_unassigned -%}
{%- set manageable_position_ids        = d.manageable_position_ids -%}
{%- set stats                          = d.stats -%}
{%- set by_group                       = d.by_group -%}
{%- set ungrouped_students             = d.ungrouped_students -%}
{%- set student_position_map           = d.student_position_map -%}
{%- set profiles                       = d.profiles -%}
{%- set profile_edit_all               = d.profile_edit_all -%}
{%- set profile_editable_ids           = d.profile_editable_ids -%}
{%- set attitude_all                   = d.attitude_all -%}
{%- set attitude_visible_ids           = d.attitude_visible_ids -%}
{%- set removable_non_ffeoe            = d.removable_non_ffeoe -%}
{%- set blocked_non_ffeoe              = d.blocked_non_ffeoe -%}
{%- set unassigned_positions           = d.unassigned_positions -%}
{%- set compatible_positions_for_student = d.compatible_positions_for_student -%}
{%- set count_without_position         = d.count_without_position -%}
{%- set count_unsigned                 = d.count_unsigned -%}
{%- set programme_teachers             = d.programme_teachers -%}
{%- set workers_by_company_id          = d.workers_by_company_id -%}
{%- set teacher_assignments            = d.teacher_assignments -%}

{% set today_str = "now"|date("Y-m-d") %}
{% set end_str   = stay.endDate|date("Y-m-d") %}
{% set start_str = stay.startDate|date("Y-m-d") %}
{% set is_past    = end_str < today_str %}
{% set is_future  = start_str > today_str and not is_past %}
{% set is_current = not is_past and not is_future %}

{% set pct_students = stats.students > 0 ? ((stats.students_with_position / stats.students) * 100)|round : 0 %}
{% set pct_occupied = stats.total_positions > 0 ? ((stats.occupied / stats.total_positions) * 100)|round : 0 %}
{% set pct_free     = stats.total_positions > 0 ? ((stats.free / stats.total_positions) * 100)|round : 0 %}

<div {{ attributes.defaults(stimulus_controller('bulk-select')) }} class="px-6 py-8 max-w-6xl mx-auto space-y-5 js-stay-detail">

    {# ── Toasts de acciones en vivo ───────────────────────────────────────── #}
    <div class="fixed bottom-4 right-4 z-50 space-y-2 pointer-events-none"
         role="status"
         aria-live="polite"
         aria-atomic="true">
        {% for flash in app.flashes('live_toast') %}
            {% set message = flash is iterable ? flash.message : flash %}
            <div class="js-live-toast pointer-events-auto flex items-center gap-2 rounded-xl bg-gray-900 px-4 py-3 text-sm text-white shadow-lg"
                 {% if flash is iterable %}data-toast-ttl="9000"{% endif %}>
                {{ ux_icon('heroicons:check-circle', {class: 'h-4 w-4 text-green-400 shrink-0'}) }}
                {{ message }}
                {% if flash is iterable and flash.undo is defined %}
                    <button type="button"
                            class="ml-2 rounded-md border border-white/30 px-2 py-0.5 text-xs font-semibold text-white hover:bg-white/10 transition-colors"
                            data-action="live#action"
                            data-live-action-param="{{ flash.undo.action }}"
                            {% for name, value in flash.undo.args %}data-live-{{ name|replace({'positionId': 'position-id'}) }}-param="{{ value is same as(true) ? 'true' : (value is same as(false) ? 'false' : value) }}" {% endfor %}>
                        {{ 'stays.toast.undo'|trans({}, 'stays') }}
                    </button>
                {% endif %}
            </div>
        {% endfor %}
    </div>

    {# ── Barra de acciones masivas (se muestra al marcar puestos; ver bulk_select_controller.js) ─── #}
    {% if manageable_position_ids is not empty %}
    <div data-bulk-select-target="bar" data-live-ignore
         class="hidden fixed bottom-4 left-1/2 z-40 -translate-x-1/2 max-w-[95vw] flex flex-wrap items-center gap-2 rounded-2xl bg-gray-900 px-4 py-3 text-sm text-white shadow-xl">
        <span data-bulk-select-target="count" data-template="{{ 'stays.bulk.selected'|trans({}, 'stays')|e('html_attr') }}" class="font-semibold"></span>
        <button type="button" data-action="bulk-select#run" data-op="pending" class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-medium hover:bg-white/20 transition-colors">{{ 'stays.state_action.to_pending'|trans({}, 'stays') }}</button>
        <button type="button" data-action="bulk-select#run" data-op="done" class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-medium hover:bg-white/20 transition-colors">{{ 'stays.state_action.to_done'|trans({}, 'stays') }}</button>
        <button type="button" data-action="bulk-select#run" data-op="sign" class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-medium hover:bg-white/20 transition-colors">{{ 'stays.state_action.sign'|trans({}, 'stays') }}</button>
        <button type="button" data-action="bulk-select#run" data-op="draft" class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-medium hover:bg-white/20 transition-colors">{{ 'stays.state_action.to_draft'|trans({}, 'stays') }}</button>
        <span class="inline-flex items-center gap-1">
            <select data-bulk-select-target="teacher" aria-label="{{ 'stays.bulk.tutor_placeholder'|trans({}, 'stays')|e('html_attr') }}"
                    class="rounded-lg border-0 bg-white/10 py-1 pl-2 pr-6 text-xs text-white focus:ring-1 focus:ring-white/50">
                <option value="" class="text-gray-900">{{ 'stays.bulk.tutor_placeholder'|trans({}, 'stays') }}</option>
                {% for teacher in programme_teachers %}
                    <option value="{{ teacher.id.toRfc4122 }}" class="text-gray-900">{{ teacher.name.lastName }} {{ teacher.name.firstName }}</option>
                {% endfor %}
            </select>
            <button type="button" data-action="bulk-select#run" data-op="tutor" class="rounded-lg bg-white/10 px-2.5 py-1 text-xs font-medium hover:bg-white/20 transition-colors">{{ 'stays.bulk.assign_tutor'|trans({}, 'stays') }}</button>
        </span>
        <button type="button" data-action="bulk-select#clear" class="rounded-lg px-2 py-1 text-xs text-white/70 hover:text-white transition-colors">{{ 'stays.bulk.clear'|trans({}, 'stays') }}</button>
    </div>
    {% endif %}

    {# ── Cabecera ─────────────────────────────────────────────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
        <div class="px-6 py-5">

            <div class="flex items-center gap-2 text-sm text-gray-500 mb-3">
            {% include 'components/_breadcrumb_home.html.twig' %}
                <a href="{{ path('app_stays_index') }}" class="hover:text-plum-600 transition-colors">
                    {{ 'stays.title'|trans({}, 'stays') }}
                </a>
                {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
                <span class="truncate text-gray-700">{{ stay.name }}</span>
            </div>

            <div class="flex flex-wrap items-start gap-3">
                <div class="flex-1 min-w-0">
                    <div class="flex flex-wrap items-center gap-2 mb-1">
                        <span class="inline-flex items-center rounded-full bg-plum-50 px-2.5 py-0.5 text-xs font-medium text-plum-700">
                            {{ stay.familyNames }}
                        </span>
                        {% if is_current %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700">
                                <span class="h-1.5 w-1.5 rounded-full animate-pulse shrink-0" style="background-color: #22c55e"></span>
                                {{ 'stays.period.badge.current'|trans({}, 'stays') }}
                            </span>
                        {% elseif is_future %}
                            <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-medium text-blue-700">
                                {{ ux_icon('heroicons:clock', {class: 'h-3 w-3'}) }}
                                {{ 'stays.period.badge.future'|trans({}, 'stays') }}
                            </span>
                        {% else %}
                            <span class="inline-flex items-center whitespace-nowrap rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-500">
                                {{ 'stays.period.badge.past'|trans({}, 'stays') }}
                            </span>
                        {% endif %}
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 leading-tight line-clamp-2 min-w-0" title="{{ stay.name }}">{{ stay.name }}</h1>
                    <p class="mt-0.5 text-sm text-gray-500">{{ stay.programmeNames }}</p>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <div class="flex items-center gap-1.5 text-sm text-gray-500 rounded-xl border border-gray-200 px-3 py-2">
                        {{ ux_icon('heroicons:calendar-days', {class: 'h-4 w-4 shrink-0 text-gray-400'}) }}
                        <span>{{ stay.startDate|date('d/m/Y') }}</span>
                        <span class="text-gray-300">→</span>
                        <span>{{ stay.endDate|date('d/m/Y') }}</span>
                    </div>
                    <a href="{{ path('app_stays_report', {id: stay.id.toRfc4122}) }}"
                       target="_blank"
                       class="inline-flex items-center gap-1 rounded-xl border border-gray-200 px-3 py-2
                              text-sm text-gray-500 hover:border-gray-300 hover:text-gray-700 hover:bg-gray-50 transition-colors"
                       title="{{ 'stays.report.btn'|trans({}, 'stays') }}" aria-label="{{ 'stays.report.btn'|trans({}, 'stays') }}">
                        {{ ux_icon('heroicons:document-arrow-down', {class: 'h-4 w-4'}) }}
                    </a>
                    <a href="{{ path('app_stays_export', {id: stay.id.toRfc4122}) }}"
                       data-controller="download-feedback"
                       data-download-feedback-message-value="{{ 'ui.export_started'|trans|e('html_attr') }}"
                       data-action="download-feedback#show"
                       class="inline-flex items-center gap-1 rounded-xl border border-gray-200 px-3 py-2
                              text-sm text-gray-500 hover:border-gray-300 hover:text-gray-700 hover:bg-gray-50 transition-colors"
                       title="{{ 'stays.export.btn'|trans({}, 'stays') }}" aria-label="{{ 'stays.export.btn'|trans({}, 'stays') }}">
                        {{ ux_icon('heroicons:table-cells', {class: 'h-4 w-4'}) }}
                    </a>
                    {% if can_manage %}
                        <a href="{{ path('app_stays_edit', {id: stay.id.toRfc4122}) }}"
                           class="inline-flex items-center gap-1 rounded-xl border border-gray-200 px-3 py-2
                                  text-sm text-gray-500 hover:border-gray-300 hover:text-gray-700 hover:bg-gray-50 transition-colors"
                           title="{{ 'stays.edit.title'|trans({}, 'stays') }}" aria-label="{{ 'stays.edit.title'|trans({}, 'stays') }}">
                            {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}
                        </a>
                        {% if can_delete %}
                        <form method="post"
                              action="{{ path('app_stays_delete', {id: stay.id.toRfc4122}) }}"
                              class="js-confirm-form"
                              data-confirm="{{ 'stays.delete.confirm'|trans({}, 'stays')|e('html_attr') }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete_stay_' ~ stay.id.toRfc4122) }}">
                            <button type="button"
                                    class="js-confirm-trigger inline-flex items-center gap-1 rounded-xl border border-red-200 px-3 py-2
                                           text-sm text-red-500 hover:border-red-300 hover:text-red-700 hover:bg-red-50 transition-colors"
                                    title="{{ 'stays.delete.btn'|trans({}, 'stays') }}" aria-label="{{ 'stays.delete.btn'|trans({}, 'stays') }}">
                                {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}
                            </button>
                        </form>
                        {% endif %}
                    {% endif %}
                </div>
            </div>
        </div>

        {# ── Stats ─────────────────────────────────────────────────────────── #}
        <div class="border-t border-gray-100 bg-gray-50/50 grid grid-cols-2 sm:grid-cols-4 divide-x divide-gray-100">
            <div class="px-5 py-4">
                <p class="text-xs text-gray-500 mb-1">{{ 'stays.card.students_with_position'|trans({}, 'stays') }}</p>
                <p class="text-lg font-bold tabular-nums
                          {{ pct_students >= 100 ? 'text-green-600' : (pct_students >= 50 ? 'text-amber-600' : 'text-gray-900') }}">
                    {{ stats.students_with_position }}<span class="text-sm font-normal text-gray-400">/{{ stats.students }}</span>
                </p>
                <p class="text-xs text-gray-400 mt-0.5">{{ pct_students }}%</p>
            </div>
            <div class="px-5 py-4">
                <p class="text-xs text-gray-500 mb-1">{{ 'stays.card.companies'|trans({}, 'stays') }}</p>
                <p class="text-lg font-bold text-gray-900 tabular-nums">{{ stats.companies }}</p>
                <p class="text-xs text-gray-400 mt-0.5">&nbsp;</p>
            </div>
            <div class="px-5 py-4">
                <p class="text-xs text-gray-500 mb-1">{{ 'stays.card.occupied'|trans({}, 'stays') }}</p>
                <p class="text-lg font-bold text-gray-900 tabular-nums">
                    {{ stats.occupied }}<span class="text-sm font-normal text-gray-400">/{{ stats.total_positions }}</span>
                </p>
                <p class="text-xs text-gray-400 mt-0.5">{{ pct_occupied }}%</p>
            </div>
            <div class="px-5 py-4">
                <p class="text-xs text-gray-500 mb-1">{{ 'stays.card.free'|trans({}, 'stays') }}</p>
                <p class="text-lg font-bold text-gray-900 tabular-nums">
                    {{ stats.free }}<span class="text-sm font-normal text-gray-400">/{{ stats.total_positions }}</span>
                </p>
                <p class="text-xs text-gray-400 mt-0.5">{{ pct_free }}%</p>
            </div>
        </div>

        {# ── Avance y siguiente paso ───────────────────────────────────────── #}
        {% set progress = d.progress %}
        <div class="border-t border-gray-100 px-6 py-4 space-y-3">
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3">
                {% for step in progress.steps %}
                    {% set pct = step.total > 0 ? ((step.done / step.total) * 100)|round : 0 %}
                    <div>
                        <div class="flex items-baseline justify-between gap-2 text-xs">
                            <span class="text-gray-500">{{ ('stays.progress.step.' ~ step.key)|trans({}, 'stays') }}</span>
                            <span class="tabular-nums font-medium text-gray-700">{{ step.done }}/{{ step.total }}</span>
                        </div>
                        <div class="mt-1 h-1.5 rounded-full bg-gray-100" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ pct }}"
                             aria-label="{{ ('stays.progress.step.' ~ step.key)|trans({}, 'stays')|e('html_attr') }}">
                            <div class="h-1.5 rounded-full {{ pct >= 100 ? 'bg-green-500' : 'bg-plum-500' }}" style="width: {{ pct }}%"></div>
                        </div>
                    </div>
                {% endfor %}
            </div>
            {% set next = progress.next %}
            <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm {{ next.key == 'complete' ? 'text-green-700' : 'text-gray-700' }}">
                {{ ux_icon(next.key == 'complete' ? 'heroicons:check-circle' : 'heroicons:arrow-right-circle', {class: 'h-4 w-4 shrink-0 ' ~ (next.key == 'complete' ? 'text-green-500' : 'text-plum-500')}) }}
                <span class="font-medium">{{ 'stays.progress.next'|trans({}, 'stays') }}</span>
                <span>{{ ('stays.progress.next_step.' ~ next.key)|trans({'%count%': next.count}, 'stays') }}</span>
                {% if next.filter %}
                    <button type="button" data-filter="{{ next.filter }}"
                            class="js-next-filter text-xs font-medium text-plum-600 hover:text-plum-800 underline">
                        {{ 'stays.progress.show'|trans({}, 'stays') }}
                    </button>
                {% elseif next.key == 'enrol' and can_manage %}
                    <a href="{{ path('app_stays_manage_students', {id: stay.id.toRfc4122}) }}" class="text-xs font-medium text-plum-600 hover:text-plum-800 underline">{{ 'stays.students.manage_btn'|trans({}, 'stays') }}</a>
                {% elseif next.key == 'create_positions' %}
                    <a href="{{ path('app_stays_new_position', {id: stay.id.toRfc4122}) }}" class="text-xs font-medium text-plum-600 hover:text-plum-800 underline">{{ 'stays.position.new_btn'|trans({}, 'stays') }}</a>
                {% endif %}
            </p>
        </div>
    </div>

    {# ── Reparto por enseñanza (estancias con varias enseñanzas) ─────────── #}
    {% if d.programme_summary is not empty %}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <div class="px-6 py-3 border-b border-gray-100">
                <h2 class="text-sm font-semibold text-gray-900">{{ 'stays.summary.title'|trans({}, 'stays') }}</h2>
                <p class="text-xs text-gray-500 mt-0.5">{{ 'stays.summary.hint'|trans({}, 'stays') }}</p>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 {{ d.programme_summary|length == 2 ? 'lg:grid-cols-2' : 'lg:grid-cols-3' }} divide-y sm:divide-y-0 sm:divide-x divide-gray-100">
                {% for row in d.programme_summary %}
                    <div class="px-6 py-4">
                        <div class="flex items-center gap-2 mb-2">
                            <p class="text-sm font-semibold text-gray-900 truncate" title="{{ row.programme.name }}">{{ row.programme.name }}</p>
                            {% if row.mine %}
                                <span class="inline-flex items-center rounded-full bg-plum-50 px-2 py-0.5 text-[11px] font-medium text-plum-700 shrink-0">{{ 'stays.summary.mine'|trans({}, 'stays') }}</span>
                            {% endif %}
                        </div>
                        <dl class="space-y-1 text-xs text-gray-600">
                            <div class="flex justify-between gap-2"><dt>{{ 'stays.summary.students'|trans({}, 'stays') }}</dt><dd class="font-semibold tabular-nums text-gray-900">{{ row.students }}</dd></div>
                            <div class="flex justify-between gap-2"><dt>{{ 'stays.summary.without_position'|trans({}, 'stays') }}</dt><dd class="font-semibold tabular-nums {{ row.without_position > 0 ? 'text-red-600' : 'text-green-600' }}">{{ row.without_position }}</dd></div>
                            {% if can_view_unassigned %}
                                <div class="flex justify-between gap-2"><dt>{{ 'stays.summary.free'|trans({}, 'stays') }}</dt><dd class="font-semibold tabular-nums text-gray-900">{{ row.free }}</dd></div>
                                {% if row.reserved_elsewhere > 0 %}
                                    <div class="flex justify-between gap-2 text-amber-700"><dt>{{ 'stays.summary.reserved_elsewhere'|trans({}, 'stays') }}</dt><dd class="font-semibold tabular-nums">{{ row.reserved_elsewhere }}</dd></div>
                                {% endif %}
                            {% endif %}
                        </dl>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {# ── Estudiantes ──────────────────────────────────────────────────────── #}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">

        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-2 flex-wrap">
            <h2 class="text-sm font-semibold text-gray-900 shrink-0">
                {{ 'stays.show.students_title'|trans({}, 'stays') }}
            </h2>
            <span class="text-xs text-gray-400 tabular-nums shrink-0">{{ stats.students }}</span>

            {% if count_without_position > 0 %}
                <span class="inline-flex items-center gap-1 rounded-full bg-red-50 border border-red-200 px-2 py-0.5 text-xs font-medium text-red-700 shrink-0">
                    {{ ux_icon('heroicons:exclamation-triangle', {class: 'h-3 w-3 shrink-0'}) }}
                    {{ 'stays.show.students_no_position'|trans({'%count%': count_without_position}, 'stays') }}
                </span>
            {% endif %}

            {% if count_unsigned > 0 %}
                <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-xs font-medium text-amber-700 shrink-0">
                    {{ ux_icon('heroicons:clock', {class: 'h-3 w-3 shrink-0'}) }}
                    {{ 'stays.show.students_unsigned'|trans({'%count%': count_unsigned}, 'stays') }}
                </span>
            {% endif %}

            <span class="ml-auto"></span>
            {% if multi_programme and manageable_student_ids is not empty %}
                <button type="button"
                        aria-pressed="false"
                        class="js-mine-toggle inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white
                               px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-xs
                               hover:border-gray-400 hover:bg-gray-50 transition-colors shrink-0"
                        title="{{ 'stays.show.mine_only_hint'|trans({}, 'stays') }}" aria-label="{{ 'stays.show.mine_only_hint'|trans({}, 'stays') }}">
                    {{ ux_icon('heroicons:user', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'stays.show.mine_only'|trans({}, 'stays') }}
                </button>
            {% endif %}
            {% if manageable_position_ids is not empty and (by_group is not empty or ungrouped_students is not empty) %}
                <button type="button"
                        aria-pressed="false"
                        class="js-quick-toggle inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white
                               px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-xs
                               hover:border-gray-400 hover:bg-gray-50 transition-colors shrink-0"
                        title="{{ 'stays.quick_mode.hint'|trans({}, 'stays') }}" aria-label="{{ 'stays.quick_mode.hint'|trans({}, 'stays') }}">
                    {{ ux_icon('heroicons:bolt', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'stays.quick_mode.toggle'|trans({}, 'stays') }}
                </button>
            {% endif %}
            {% if can_manage %}
                <a href="{{ path('app_stays_manage_students', {id: stay.id.toRfc4122}) }}"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white
                          px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-xs
                          hover:border-gray-400 hover:bg-gray-50 transition-colors shrink-0">
                    {{ ux_icon('heroicons:user-group', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'stays.students.manage_btn'|trans({}, 'stays') }}
                </a>
            {% endif %}
        </div>

        {# Alumnado que no realiza la FFEOE y sigue en la estancia: se ofrece quitarlo de una vez. #}
        {% if removable_non_ffeoe is not empty or blocked_non_ffeoe > 0 %}
        <div class="px-6 py-2.5 border-b border-gray-100 bg-gray-50/70 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-gray-600">
            <span class="inline-flex items-center gap-1.5">
                {{ ux_icon('heroicons:information-circle', {class: 'h-4 w-4 text-gray-400 shrink-0'}) }}
                {{ 'student_profile.remove.text'|trans({'%count%': removable_non_ffeoe|length + blocked_non_ffeoe}, 'stays') }}
                {% if blocked_non_ffeoe > 0 %}{{ 'student_profile.remove.blocked'|trans({'%count%': blocked_non_ffeoe}, 'stays') }}{% endif %}
            </span>
            {% if removable_non_ffeoe is not empty %}
                <form class="js-confirm-form" data-live-action="removeNonFfeoeStudents" data-live-params="{}"
                      data-confirm="{{ 'student_profile.remove.confirm'|trans({'%count%': removable_non_ffeoe|length}, 'stays')|e('html_attr') }}"
                      data-confirm-label="{{ 'student_profile.remove.button'|trans({}, 'stays')|e('html_attr') }}">
                    <button type="button"
                            class="js-confirm-trigger inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white px-2.5 py-1 text-xs font-semibold text-gray-700 shadow-xs hover:bg-gray-50 transition-colors">
                        {{ 'student_profile.remove.button'|trans({}, 'stays') }}
                    </button>
                </form>
            {% endif %}
        </div>
        {% endif %}

        {% if by_group is not empty or ungrouped_students is not empty %}
        <div class="px-6 py-2.5 border-b border-gray-100 flex flex-wrap items-center gap-1.5">
            <span class="text-xs text-gray-400 mr-1">{{ 'stays.quickfilter.title'|trans({}, 'stays') }}</span>
            {% for key in ['sin-puesto', 'sin-tutor', 'sin-empresa', 'sin-firmar', 'libres', 'sin-nuss', 'no-ffeoe'] %}
                <button type="button" data-filter="{{ key }}" aria-pressed="false"
                        class="js-filter-chip hidden inline-flex items-center gap-1 rounded-full border border-gray-200 bg-white px-2.5 py-0.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">
                    {{ ('stays.quickfilter.' ~ key)|trans({}, 'stays') }}
                    <span class="js-chip-count tabular-nums text-gray-400"></span>
                </button>
            {% endfor %}
            <button type="button" class="js-filter-clear hidden text-xs text-plum-600 hover:text-plum-800 ml-1">{{ 'stays.quickfilter.clear'|trans({}, 'stays') }}</button>
        </div>
        {% endif %}

        {% if by_group is empty and ungrouped_students is empty %}
            <div class="px-6 py-14 text-center">
                {{ ux_icon('heroicons:user-group', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
                <p class="text-sm text-gray-500">{{ 'stays.show.students_empty'|trans({}, 'stays') }}</p>
                {% if can_manage %}
                    <a href="{{ path('app_stays_manage_students', {id: stay.id.toRfc4122}) }}"
                       class="mt-4 inline-flex items-center gap-1.5 rounded-lg border border-plum-600 bg-plum-600
                              px-3 py-1.5 text-xs font-semibold text-white shadow-xs
                              hover:border-plum-700 hover:bg-plum-700 transition-colors">
                        {{ ux_icon('heroicons:user-group', {class: 'h-3.5 w-3.5'}) }}
                        {{ 'stays.students.manage_btn'|trans({}, 'stays') }}
                    </a>
                {% endif %}
            </div>
        {% else %}
            <div class="overflow-x-auto">
                <table class="table-cards min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50/50">
                            <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide min-w-[15rem] xl:min-w-[19rem]">
                                {% if manageable_position_ids is not empty %}<input type="checkbox" data-bulk-select-target="all" data-action="change->bulk-select#toggleAll"
                                       class="mr-2 h-4 w-4 align-middle rounded border-gray-300 text-plum-600 focus:ring-plum-500"
                                       aria-label="{{ 'stays.bulk.select_all'|trans({}, 'stays')|e('html_attr') }}">{% endif %}
                                {{ 'stays.show.col.student'|trans({}, 'stays') }}
                            </th>
                            <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide min-w-[13rem]">
                                {{ 'stays.show.col.workcenter'|trans({}, 'stays') }}
                            </th>
                            <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide hidden xl:table-cell">
                                {{ 'stays.show.col.tutors'|trans({}, 'stays') }}
                            </th>
                            <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide hidden sm:table-cell">
                                {{ 'stays.show.col.state'|trans({}, 'stays') }}
                            </th>
                            {% if can_manage or manageable_position_ids is not empty %}<th scope="col" class="px-3 py-3 w-24"></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">

                        {% for entry in by_group %}
                            <tr class="table-group-header">
                                <td colspan="99" class="px-5 py-2 bg-gray-50/70 border-y border-gray-100">
                                    <div class="flex items-center gap-2">
                                        {{ ux_icon('heroicons:users', {class: 'h-3.5 w-3.5 text-gray-400 shrink-0'}) }}
                                        <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide">{{ entry.group.name }}</span>
                                        {% if multi_programme %}
                                            <span class="inline-flex items-center rounded-full bg-plum-50 px-2 py-0.5 text-[11px] font-medium text-plum-700">
                                                {{ entry.group.programmeYear.programme.name }}
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>

                            {% for student in entry.students %}
                                {% include 'stays/detail/_student_row.html.twig' %}
                            {% endfor %}
                        {% endfor %}

                        {# ── Ungrouped students ─────────────────────────────────── #}
                        {% if ungrouped_students is not empty %}
                            <tr class="table-group-header">
                                <td colspan="99" class="px-5 py-2 bg-gray-50/70 border-y border-gray-100">
                                    <div class="flex items-center gap-2">
                                        {{ ux_icon('heroicons:question-mark-circle', {class: 'h-3.5 w-3.5 text-gray-400 shrink-0'}) }}
                                        <span class="text-xs font-semibold text-gray-600 uppercase tracking-wide">{{ 'stays.show.no_group'|trans({}, 'stays') }}</span>
                                    </div>
                                </td>
                            </tr>
                            {% for student in ungrouped_students %}
                                {% include 'stays/detail/_student_row.html.twig' %}
                            {% endfor %}
                        {% endif %}

                    </tbody>
                </table>
            </div>
        {% endif %}

    </div>

    {# ── Docentes: reparto de tutorías duales (ajuste «Calcular asignaciones por docente») ── #}
    {% if teacher_assignments is not null %}
    <div id="stay-teachers" class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">

        <div class="px-6 py-4 border-b border-gray-100">
            <h2 class="text-sm font-semibold text-gray-900">{{ 'stays.teachers.title'|trans({}, 'stays') }}</h2>
            <p class="mt-1 text-xs text-gray-500">{{ 'stays.teachers.intro'|trans({}, 'stays') }}</p>
        </div>

        {% if teacher_assignments.groups is empty %}
            <p class="px-6 py-6 text-sm text-gray-500">{{ 'stays.teachers.no_groups'|trans({}, 'stays') }}</p>
        {% else %}

            {# Resumen por docente (suma de todos los grupos) #}
            {% if teacher_assignments.teachers is empty %}
                <p class="px-6 py-4 text-sm text-gray-500">
                    {{ (can_manage ? 'stays.teachers.no_hours_manage' : 'stays.teachers.no_hours')|trans({}, 'stays') }}
                </p>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="min-w-full text-sm table-cards">
                        <thead>
                            <tr class="border-b border-gray-100 bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-500">
                                <th scope="col" class="px-6 py-2.5 font-medium">{{ 'stays.teachers.col.teacher'|trans({}, 'stays') }}</th>
                                <th scope="col" class="px-4 py-2.5 font-medium text-right">{{ 'stays.teachers.col.expected'|trans({}, 'stays') }}</th>
                                <th scope="col" class="px-4 py-2.5 font-medium text-right">{{ 'stays.teachers.col.assigned'|trans({}, 'stays') }}</th>
                                <th scope="col" class="px-6 py-2.5 font-medium">{{ 'stays.teachers.col.balance'|trans({}, 'stays') }}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-50">
                            {% for t in teacher_assignments.teachers %}
                                <tr>
                                    <td data-label="{{ 'stays.teachers.col.teacher'|trans({}, 'stays')|e('html_attr') }}" class="px-6 py-3">
                                        <p class="font-medium text-gray-900">{{ t.teacher.name.full() }}</p>
                                        <p class="text-xs text-gray-500">
                                            {% for g in t.by_group %}{{ g.group.name }}: {{ g.assigned }}/{{ g.expected }}{{ loop.last ? '' : ' · ' }}{% endfor %}
                                        </p>
                                    </td>
                                    <td data-label="{{ 'stays.teachers.col.expected'|trans({}, 'stays')|e('html_attr') }}" class="px-4 py-3 text-right tabular-nums">{{ t.expected }}</td>
                                    <td data-label="{{ 'stays.teachers.col.assigned'|trans({}, 'stays')|e('html_attr') }}" class="px-4 py-3 text-right tabular-nums">{{ t.assigned }}</td>
                                    <td data-label="{{ 'stays.teachers.col.balance'|trans({}, 'stays')|e('html_attr') }}" class="px-6 py-3 text-xs font-medium">{{ _self.balance(t.expected, t.assigned) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}

            {# Horas dualizadas por grupo #}
            <div class="border-t border-gray-100 divide-y divide-gray-100">
                {% for entry in teacher_assignments.groups %}
                    <div class="px-6 py-4">
                        <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <h3 class="text-sm font-semibold text-gray-800">{{ entry.group.name }}</h3>
                            <span class="text-xs text-gray-500">{{ 'stays.teachers.group_students'|trans({'%count%': entry.students}, 'stays') }}</span>
                            <span class="text-xs text-gray-500 tabular-nums">{{ 'stays.teachers.group_hours_total'|trans({'%count%': entry.total_hours}, 'stays') }}</span>
                        </div>

                        {% if entry.rows is empty %}
                            <p class="mt-2 text-xs text-gray-500">{{ 'stays.teachers.group_no_teachers'|trans({}, 'stays') }}</p>
                        {% else %}
                            <table class="mt-2 min-w-full text-sm table-cards">
                                <thead>
                                    <tr class="text-left text-xs uppercase tracking-wide text-gray-500">
                                        <th scope="col" class="py-1.5 pr-4 font-medium">{{ 'stays.teachers.col.teacher'|trans({}, 'stays') }}</th>
                                        <th scope="col" class="py-1.5 px-4 font-medium text-right">{{ 'stays.teachers.col.hours'|trans({}, 'stays') }}</th>
                                        <th scope="col" class="py-1.5 px-4 font-medium text-right">{{ 'stays.teachers.col.expected'|trans({}, 'stays') }}</th>
                                        <th scope="col" class="py-1.5 pl-4 font-medium text-right">{{ 'stays.teachers.col.assigned'|trans({}, 'stays') }}</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-50">
                                    {% for row in entry.rows %}
                                        <tr>
                                            <td data-label="{{ 'stays.teachers.col.teacher'|trans({}, 'stays')|e('html_attr') }}" class="py-2 pr-4 text-gray-800">
                                                {{ row.teacher.name.full() }}
                                                {% if not row.in_group %}
                                                    <span class="ml-1 text-xs text-gray-500">({{ 'stays.teachers.not_in_group'|trans({}, 'stays') }})</span>
                                                {% endif %}
                                            </td>
                                            <td data-label="{{ 'stays.teachers.col.hours'|trans({}, 'stays')|e('html_attr') }}" class="py-2 px-4 text-right">
                                                {% if can_manage and row.in_group %}
                                                    <input type="number" min="0" max="9999" step="1" inputmode="numeric"
                                                           class="js-teacher-hours w-20 rounded-lg border border-gray-200 bg-white px-2 py-1 text-right text-sm tabular-nums focus:border-plum-400 focus:outline-none focus:ring-2 focus:ring-plum-100"
                                                           value="{{ row.hours > 0 ? row.hours : '' }}" placeholder="0"
                                                           data-group-id="{{ entry.group.id.toRfc4122 }}"
                                                           data-teacher-id="{{ row.teacher.id.toRfc4122 }}"
                                                           aria-label="{{ 'stays.teachers.hours_label'|trans({'%teacher%': row.teacher.name.full(), '%group%': entry.group.name}, 'stays')|e('html_attr') }}">
                                                {% else %}
                                                    <span class="tabular-nums">{{ row.hours }}</span>
                                                {% endif %}
                                            </td>
                                            <td data-label="{{ 'stays.teachers.col.expected'|trans({}, 'stays')|e('html_attr') }}" class="py-2 px-4 text-right tabular-nums">{{ row.expected }}</td>
                                            <td data-label="{{ 'stays.teachers.col.assigned'|trans({}, 'stays')|e('html_attr') }}" class="py-2 pl-4 text-right tabular-nums">{{ row.assigned }}</td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
    {% endif %}

    {# ── Puestos sin asignar (solo gestores y docentes de enlace) ─────────── #}
    {% if can_view_unassigned %}
    <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">

        <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
            <h2 class="text-sm font-semibold text-gray-900">
                {{ 'stays.show.unassigned_positions_title'|trans({}, 'stays') }}
            </h2>
            <span class="text-xs text-gray-400 tabular-nums">
                {{ 'stays.show.positions_count'|trans({'%count%': unassigned_positions|length}, 'stays') }}
            </span>
            {% if can_add_position %}
                <a href="{{ path('app_stays_copy_positions', {id: stay.id.toRfc4122}) }}"
                   class="ml-auto inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white
                          px-3 py-1.5 text-xs font-semibold text-gray-700 shadow-xs
                          hover:border-gray-400 hover:bg-gray-50 transition-colors">
                    {{ ux_icon('heroicons:document-duplicate', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'stays.copy.btn'|trans({}, 'stays') }}
                </a>
                <a href="{{ path('app_stays_new_position', {id: stay.id.toRfc4122}) }}"
                   class="inline-flex items-center gap-1.5 rounded-lg border border-plum-600 bg-plum-600
                          px-3 py-1.5 text-xs font-semibold text-white shadow-xs
                          hover:border-plum-700 hover:bg-plum-700 transition-colors">
                    {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
                    {{ 'stays.position.new_btn'|trans({}, 'stays') }}
                </a>
            {% endif %}
        </div>

        {% if unassigned_positions is empty %}
            {% if stats.total_positions == 0 %}
                {# La estancia aún no tiene ningún puesto: guía en vez de un falso «todos asignados». #}
                <div class="px-6 py-10 text-center">
                    {{ ux_icon('heroicons:briefcase', {class: 'mx-auto h-8 w-8 text-gray-300 mb-2'}) }}
                    <p class="text-sm text-gray-500">{{ 'stays.show.no_positions_yet'|trans({}, 'stays') }}</p>
                    {% if can_add_position %}
                        <div class="mt-4 flex flex-wrap items-center justify-center gap-2">
                            {# Mismo orden que la cabecera de la sección: la acción secundaria primero y la principal a la derecha. #}
                            <a href="{{ path('app_stays_copy_positions', {id: stay.id.toRfc4122}) }}"
                               class="inline-flex items-center gap-1.5 rounded-lg border border-gray-300 bg-white px-3 py-1.5 text-xs font-semibold text-gray-700 hover:bg-gray-50 transition-colors">
                                {{ ux_icon('heroicons:document-duplicate', {class: 'h-3.5 w-3.5'}) }}
                                {{ 'stays.copy.btn'|trans({}, 'stays') }}
                            </a>
                            <a href="{{ path('app_stays_new_position', {id: stay.id.toRfc4122}) }}"
                               class="inline-flex items-center gap-1.5 rounded-lg bg-plum-600 px-3 py-1.5 text-xs font-semibold text-white shadow-xs hover:bg-plum-700 transition-colors">
                                {{ ux_icon('heroicons:plus', {class: 'h-3.5 w-3.5'}) }}
                                {{ 'stays.position.new_btn'|trans({}, 'stays') }}
                            </a>
                        </div>
                    {% endif %}
                </div>
            {% else %}
            <div class="px-6 py-10 text-center">
                {{ ux_icon('heroicons:check-circle', {class: 'mx-auto h-8 w-8 text-green-400 mb-2'}) }}
                <p class="text-sm text-gray-500">{{ 'stays.show.no_unassigned_positions'|trans({}, 'stays') }}</p>
            </div>
            {% endif %}
        {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50/50">
                            <th scope="col" class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide w-56">
                                {{ 'stays.show.col.workcenter'|trans({}, 'stays') }}
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide hidden md:table-cell w-32">
                                {{ 'stays.show.col.levels'|trans({}, 'stays') }}
                            </th>
                            <th scope="col" class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wide">
                                {{ 'stays.show.col.details'|trans({}, 'stays') }}
                            </th>
                            {% if can_manage or manageable_position_ids is not empty %}<th scope="col" class="px-3 py-3 w-20"></th>{% endif %}
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for position in unassigned_positions %}
                            <tr class="hover:bg-gray-50/50 transition-colors" data-sync-key="position-{{ position.id.toRfc4122 }}" data-flags="libres">
                                <td class="px-5 py-3.5">
                                    {% if position.workcenter %}
                                        <p class="font-medium text-gray-900 leading-snug">{{ position.workcenter.company.name }}</p>
                                        <p class="text-xs text-gray-500 mt-0.5">{{ position.workcenter.name }}{% if position.workcenter.city %} · {{ position.workcenter.city }}{% endif %}</p>
                                    {% else %}
                                        <span class="text-xs text-gray-400 italic">{{ 'stays.show.no_workcenter'|trans({}, 'stays') }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3.5 hidden md:table-cell">
                                    {% if position.programmeYears is not empty %}
                                        <div class="flex flex-wrap gap-1">
                                            {% for py in position.programmeYears %}
                                                <span class="inline-flex items-center rounded-full bg-plum-50 px-2 py-0.5 text-xs font-medium text-plum-700"
                                                      {% if multi_programme %}title="{{ py.programme.name|e('html_attr') }}"{% endif %}>
                                                    {% if multi_programme %}{{ py.programme.name }} · {% endif %}{{ py.name }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                    {% else %}
                                        <span class="text-gray-300">—</span>
                                    {% endif %}
                                    {% if position.priorityProgramme and position.priorityUntil|date('Y-m-d') >= today_str %}
                                        <p class="mt-1 inline-flex items-center gap-1 rounded-full bg-amber-50 border border-amber-200 px-2 py-0.5 text-[11px] font-medium text-amber-700">
                                            {{ ux_icon('heroicons:star', {class: 'h-3 w-3 shrink-0'}) }}
                                            {{ 'stays.position.priority_badge'|trans({'%programme%': position.priorityProgramme.name, '%date%': position.priorityUntil|date('d/m/Y')}, 'stays') }}
                                        </p>
                                    {% endif %}
                                </td>
                                <td class="px-4 py-3.5 text-sm text-gray-600">
                                    {% if position.details %}
                                        <p class="line-clamp-3 leading-relaxed">{{ position.details }}</p>
                                    {% else %}
                                        <span class="text-gray-300">—</span>
                                    {% endif %}
                                </td>
                                {% if manageable_position_ids[position.id.toRfc4122] is defined %}
                                <td class="px-3 py-3.5 text-right">
                                    <div class="inline-flex items-center gap-1">
                                        <a href="{{ path('app_stays_edit_position', {id: stay.id.toRfc4122, positionId: position.id.toRfc4122}) }}"
                                           class="inline-flex items-center rounded-lg border border-gray-200 p-1.5
                                                  text-gray-400 hover:border-gray-300 hover:text-gray-600 hover:bg-gray-50 transition-colors"
                                           title="{{ 'stays.position.edit.title'|trans({}, 'stays') }}" aria-label="{{ 'stays.position.edit.title'|trans({}, 'stays') }}">
                                            {{ ux_icon('heroicons:pencil-square', {class: 'h-4 w-4'}) }}
                                        </a>
                                        <form method="post"
                                              action="{{ path('app_stays_duplicate_position', {id: stay.id.toRfc4122, positionId: position.id.toRfc4122}) }}"
                                              class="js-confirm-form"
                                              data-confirm="{{ 'stays.position.duplicate.confirm'|trans({}, 'stays')|e('html_attr') }}"
                                              data-confirm-label="{{ 'stays.position.duplicate.btn'|trans({}, 'stays')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('duplicate_position_' ~ position.id.toRfc4122) }}">
                                            <button type="button"
                                                    class="js-confirm-trigger inline-flex items-center rounded-lg border border-gray-200 p-1.5
                                                           text-gray-400 hover:border-gray-300 hover:text-gray-600 hover:bg-gray-50 transition-colors"
                                                    title="{{ 'stays.position.duplicate.btn'|trans({}, 'stays') }}" aria-label="{{ 'stays.position.duplicate.btn'|trans({}, 'stays') }}">
                                                {{ ux_icon('heroicons:document-duplicate', {class: 'h-4 w-4'}) }}
                                            </button>
                                        </form>
                                        <form method="post"
                                              action="{{ path('app_stays_delete_position', {id: stay.id.toRfc4122, positionId: position.id.toRfc4122}) }}"
                                              class="js-confirm-form"
                                              data-confirm="{{ 'stays.position.delete.confirm'|trans({}, 'stays')|e('html_attr') }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_position_' ~ position.id.toRfc4122) }}">
                                            <button type="button"
                                                    class="js-confirm-trigger inline-flex items-center rounded-lg border border-red-200 p-1.5
                                                           text-red-400 hover:border-red-300 hover:text-red-600 hover:bg-red-50 transition-colors"
                                                    title="{{ 'stays.position.delete.btn'|trans({}, 'stays') }}" aria-label="{{ 'stays.position.delete.btn'|trans({}, 'stays') }}">
                                                {{ ux_icon('heroicons:trash', {class: 'h-4 w-4'}) }}
                                            </button>
                                        </form>
                                    </div>
                                </td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}

    </div>
    {% endif %}

<script type="module" data-live-ignore>
import TomSelect from 'tom-select';
import { getComponent } from '@symfony/ux-live-component';

let liveEl  = null;
let liveComp = null;
// Preferencias del navegador (recordadas entre estancias): puede no haber almacenamiento disponible.
function readPref(key) {
    try { return window.localStorage.getItem('nexo.stay.' + key) === '1'; } catch (e) { return false; }
}
function writePref(key, value) {
    try { window.localStorage.setItem('nexo.stay.' + key, value ? '1' : '0'); } catch (e) { /* sin almacenamiento */ }
}

let quickMode = readPref('quickMode');
let mineOnly  = readPref('mineOnly');
const FILTERS = ['sin-puesto', 'sin-tutor', 'sin-empresa', 'sin-firmar', 'libres', 'sin-nuss', 'no-ffeoe'];
let activeFilter = new URLSearchParams(window.location.search).get('filtro');
if (!FILTERS.includes(activeFilter)) activeFilter = null;

const LABEL_CANCEL  = '{{ 'ui.cancel'|trans }}';
const LABEL_CONFIRM = '{{ 'ui.confirm_delete'|trans }}';

// ── Diálogo de confirmación propio de la aplicación ───────────────────────────
// Modal centrado anclado a <body>, así nunca lo recorta el contenedor de la fila. Accesible:
// role=dialog, Escape y clic fuera lo cancelan, foco atrapado y devuelto al disparador.
// Lo usan las acciones destructivas (borrar, duplicar) y los avisos previos a una asignación.
//   message, label     texto y botón de confirmar
//   copiesMax/Label    si copiesMax > 0, pide además un número de 1 a copiesMax (onConfirm lo recibe)
//   warning            tono ámbar en lugar de rojo, para avisos que no son destructivos
//   onConfirm, onCancel
function showConfirmDialog(opts) {
    if (document.querySelector('.js-confirm-overlay')) return;
    const previousFocus = document.activeElement;
    const warning = !!opts.warning;

    const overlay = document.createElement('div');
    overlay.className = 'js-confirm-overlay fixed inset-0 z-[60] flex items-center justify-center bg-black/50 px-4';

    const dialog = document.createElement('div');
    dialog.setAttribute('role', 'dialog');
    dialog.setAttribute('aria-modal', 'true');
    dialog.className = 'w-full max-w-sm rounded-2xl border bg-white p-5 shadow-xl ' + (warning ? 'border-amber-200' : 'border-red-200');
    dialog.innerHTML =
        '<p class="text-sm leading-snug text-gray-700 mb-4"></p>' +
        '<div class="flex items-center justify-end gap-2">' +
        '  <button type="button" class="js-confirm-cancel rounded-lg border border-gray-200 px-3 py-1.5 text-xs font-medium text-gray-600 hover:bg-gray-50 transition-colors">' + LABEL_CANCEL + '</button>' +
        '  <button type="button" class="js-confirm-go rounded-lg px-3 py-1.5 text-xs font-semibold text-white transition-colors ' + (warning ? 'bg-amber-600 hover:bg-amber-700' : 'bg-red-600 hover:bg-red-700') + '"></button>' +
        '</div>';
    dialog.querySelector('p').textContent = opts.message ?? '';
    dialog.querySelector('.js-confirm-go').textContent = opts.label ?? LABEL_CONFIRM;

    // Diálogos que piden además un número (p. ej. cuántas copias de un puesto crear)
    let copiesInput = null;
    if (opts.copiesMax > 0) {
        const label = document.createElement('label');
        label.className = 'mb-4 flex items-center gap-2 text-sm text-gray-700';
        label.textContent = opts.copiesLabel ?? '';
        copiesInput = document.createElement('input');
        copiesInput.type = 'number';
        copiesInput.min = '1';
        copiesInput.max = String(opts.copiesMax);
        copiesInput.value = '1';
        copiesInput.className = 'w-20 rounded-lg border border-gray-300 px-2 py-1 text-sm focus:border-plum-500 focus:outline-none focus:ring-1 focus:ring-plum-500';
        label.appendChild(copiesInput);
        dialog.insertBefore(label, dialog.querySelector('.flex.items-center.justify-end'));
    }
    overlay.appendChild(dialog);
    document.body.appendChild(overlay);

    const cancelBtn = dialog.querySelector('.js-confirm-cancel');
    const goBtn     = dialog.querySelector('.js-confirm-go');

    function closeDialog() {
        document.removeEventListener('keydown', onKeydown);
        overlay.remove();
        if (previousFocus && typeof previousFocus.focus === 'function') previousFocus.focus();
    }
    function cancel() {
        closeDialog();
        if (opts.onCancel) opts.onCancel();
    }
    function onKeydown(ev) {
        if (ev.key === 'Escape') { ev.preventDefault(); cancel(); return; }
        if (ev.key === 'Tab') {
            const f = dialog.querySelectorAll('button');
            const first = f[0], last = f[f.length - 1];
            if (ev.shiftKey && document.activeElement === first) { ev.preventDefault(); last.focus(); }
            else if (!ev.shiftKey && document.activeElement === last) { ev.preventDefault(); first.focus(); }
        }
    }
    cancelBtn.addEventListener('click', cancel);
    overlay.addEventListener('mousedown', function (ev) { if (ev.target === overlay) cancel(); });
    goBtn.addEventListener('click', function () {
        const copies = copiesInput
            ? Math.max(1, Math.min(opts.copiesMax, parseInt(copiesInput.value, 10) || 1))
            : null;
        closeDialog();
        if (opts.onConfirm) opts.onConfirm(copies);
    });
    document.addEventListener('keydown', onKeydown);
    cancelBtn.focus();
}

// ── Single delegated listener for all interactive clicks ──────────────────────
// Handles confirm panels, assign triggers, and inline triggers. Using delegation
// (instead of per-element listeners) avoids stale listener accumulation across
// Idiomorph re-renders, which morph elements in place but fire live:render after.
function setupEventDelegation() {
    // Horas dualizadas de un docente en un grupo (ajuste «Calcular asignaciones por docente»):
    // se guardan al salir del campo o pulsar Intro.
    liveEl.addEventListener('change', function (e) {
        const input = e.target.closest('.js-teacher-hours');
        if (!input || !liveComp) return;
        liveComp.action('setTeacherHours', {
            groupId:   input.dataset.groupId,
            teacherId: input.dataset.teacherId,
            hours:     input.value,
        });
    });

    liveEl.addEventListener('click', function (e) {

        // Filtro «solo mis estudiantes» (estancias con varias enseñanzas)
        const mineToggle = e.target.closest('.js-mine-toggle');
        if (mineToggle) {
            mineOnly = !mineOnly;
            writePref('mineOnly', mineOnly);
            applyMineOnly();
            return;
        }

        // Filtros rápidos («Sin tutor», «Sin firmar»…)
        const chip = e.target.closest('.js-filter-chip');
        if (chip) {
            activeFilter = activeFilter === chip.dataset.filter ? null : chip.dataset.filter;
            applyMineOnly();
            return;
        }
        const nextFilter = e.target.closest('.js-next-filter');
        if (nextFilter) {
            activeFilter = nextFilter.dataset.filter;
            applyMineOnly();
            liveEl.querySelector('.js-filter-chip')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            return;
        }
        if (e.target.closest('.js-filter-clear')) {
            activeFilter = null;
            applyMineOnly();
            return;
        }

        // Quick assignment mode toggle
        const quickToggle = e.target.closest('.js-quick-toggle');
        if (quickToggle) {
            quickMode = !quickMode;
            writePref('quickMode', quickMode);
            applyQuickMode();
            return;
        }

        // Confirm dialog: modal centrado anclado a <body>, así nunca lo recorta
        // el contenedor de la fila (antes era un panel posicionado que se cortaba
        // al final de la tabla). Accesible: role=dialog, Escape, foco atrapado.
        const confirmTrigger = e.target.closest('.js-confirm-trigger');
        if (confirmTrigger) {
            e.stopPropagation();
            const form = confirmTrigger.closest('.js-confirm-form');
            if (!form || document.querySelector('.js-confirm-overlay')) return;
            const isLive = !!form.dataset.liveAction;
            showConfirmDialog({
                message: form.dataset.confirm ?? '',
                label: form.dataset.confirmLabel || LABEL_CONFIRM,
                copiesMax: form.dataset.confirmCopies ? parseInt(form.dataset.confirmCopies, 10) : 0,
                copiesLabel: form.dataset.confirmCopiesLabel ?? '',
                onConfirm: function (copies) {
                    if (copies !== null) {
                        const hidden = form.querySelector('input[name="copies"]');
                        if (hidden) hidden.value = String(copies);
                    }
                    if (isLive) {
                        if (liveComp) liveComp.action(form.dataset.liveAction, JSON.parse(form.dataset.liveParams || '{}'));
                    } else if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit();
                    } else {
                        form.submit();
                    }
                },
            });
            return;
        }

        // Position assign dropdown trigger
        const assignTrigger = e.target.closest('.js-assign-trigger');
        if (assignTrigger) {
            const form     = assignTrigger.closest('.js-assign-form');
            if (!form) return;
            const wrap     = form.querySelector('.js-assign-select');
            const dropdown = form.querySelector('.js-assign-dropdown');
            if (!wrap || !dropdown || !dropdown.tomselect) return;
            wrap.classList.remove('hidden');
            assignTrigger.classList.add('hidden');
            requestAnimationFrame(function () { dropdown.tomselect.open(); });
            return;
        }

        // Inline tutor / mentor dropdown trigger
        const inlineTrigger = e.target.closest('.js-inline-trigger');
        if (inlineTrigger) {
            const form     = inlineTrigger.closest('.js-inline-assign-form');
            if (!form) return;
            const wrap     = form.querySelector('.js-inline-select-wrap');
            const dropdown = form.querySelector('.js-inline-select');
            if (!wrap || !dropdown || !dropdown.tomselect) return;
            wrap.classList.remove('hidden');
            inlineTrigger.classList.add('hidden');
            requestAnimationFrame(function () { dropdown.tomselect.open(); });
            return;
        }
    });
}

// ── Tom Select helpers ────────────────────────────────────────────────────────
// No data-live-ignore on forms: Idiomorph removes the Tom Select wrapper on each
// re-render and restores a plain <select> from the new server HTML, so
// dropdown.tomselect is always undefined on a fresh render cycle. Trigger clicks
// are handled via delegation above, so no per-form click listeners are added.
function initAssignForm(form) {
    const trigger  = form.querySelector('.js-assign-trigger');
    const wrap     = form.querySelector('.js-assign-select');
    const dropdown = form.querySelector('.js-assign-dropdown');
    if (!trigger || !wrap || !dropdown || dropdown.tomselect) return;

    const studentId = form.dataset.studentId;
    const ph = dropdown.querySelector('option[value=""]')?.textContent.trim() ?? '';
    const opts = [{ value: '', text: ph, company: '', center: '', city: '', details: '', search: '' }];
    dropdown.querySelectorAll('option:not([value=""])').forEach(function (opt) {
        const company = opt.dataset.company ?? '', center = opt.dataset.center ?? '';
        const city    = opt.dataset.city    ?? '', details = opt.dataset.details ?? '';
        opts.push({ value: opt.value, text: opt.textContent.trim(), company, center, city, details,
            search: [company, center, city, details].filter(Boolean).join(' ') });
    });

    new TomSelect(dropdown, {
        options: opts, items: [], valueField: 'value', labelField: 'text',
        searchField: ['search'], allowEmptyOption: false, create: false, maxOptions: null,
        placeholder: ph, wrapperClass: 'ts-wrapper ts-local', dropdownParent: 'body',
        render: {
            option: function (d, esc) {
                if (!d.value) return '<div class="py-0.5 text-gray-400 italic">' + esc(d.text) + '</div>';
                const citySpan = d.city    ? ' <span class="ts-wc-city">· ' + esc(d.city) + '</span>' : '';
                const detailEl = d.details ? '<p class="ts-pos-details">' + esc(d.details) + '</p>' : '';
                return '<div class="ts-pos-option"><p class="ts-pos-company">' + esc(d.company) + '</p>'
                     + '<p class="ts-pos-sub">' + esc(d.center) + citySpan + '</p>' + detailEl + '</div>';
            },
            item: function (d, esc) {
                if (!d.value) return '<div>' + esc(d.text) + '</div>';
                return '<div class="ts-wc-item"><span class="ts-wc-company">' + esc(d.company) + '</span>'
                     + '<span class="ts-wc-sep">·</span><span class="ts-wc-sub">' + esc(d.center) + '</span></div>';
            },
            no_results: function () {
                return '<div class="no-results px-3 py-2 text-sm">{{ 'stays.position.field.workcenter_no_results'|trans({}, 'stays') }}</div>';
            },
        },
        onChange: function (positionId) {
            if (!positionId || !liveComp) return;
            // Sin NUSS no puede realizar la estancia: se avisa y hay que confirmar.
            if (form.dataset.nussWarning) {
                showConfirmDialog({
                    message: form.dataset.nussWarning,
                    label: form.dataset.nussConfirmLabel || LABEL_CONFIRM,
                    warning: true,
                    onConfirm: function () { liveComp.action('assignPosition', { studentId, positionId }); },
                    onCancel: function () { dropdown.tomselect?.clear(true); },
                });
                return;
            }
            liveComp.action('assignPosition', { studentId, positionId });
        },
        onDropdownClose: function () {
            if (quickMode) return;
            wrap.classList.add('hidden');
            trigger.classList.remove('hidden');
        },
    });
}

function initInlineForm(form) {
    const trigger    = form.querySelector('.js-inline-trigger');
    const wrap       = form.querySelector('.js-inline-select-wrap');
    const dropdown   = form.querySelector('.js-inline-select');
    if (!trigger || !wrap || !dropdown || dropdown.tomselect) return;

    const positionId = form.dataset.positionId;
    const actionName = form.dataset.liveAction;
    const argName    = form.dataset.liveArgName;

    const ph   = dropdown.querySelector('option[value=""]')?.textContent.trim() ?? '';
    const opts = [{ value: '', text: ph }];
    dropdown.querySelectorAll('option:not([value=""])').forEach(function (opt) {
        opts.push({ value: opt.value, text: opt.textContent.trim() });
    });

    new TomSelect(dropdown, {
        options: opts, items: [], valueField: 'value', labelField: 'text',
        searchField: ['text'], allowEmptyOption: false, create: false, maxOptions: null,
        placeholder: ph, wrapperClass: 'ts-wrapper ts-local', dropdownParent: 'body',
        onChange: function (value) {
            if (!value || !liveComp) return;
            const params = { positionId };
            params[argName] = value;
            liveComp.action(actionName, params);
        },
        onDropdownClose: function () {
            if (quickMode) return;
            wrap.classList.add('hidden');
            trigger.classList.remove('hidden');
        },
    });
}

function initAllForms() {
    liveEl.querySelectorAll('.js-assign-form').forEach(initAssignForm);
    liveEl.querySelectorAll('.js-inline-assign-form').forEach(initInlineForm);
}

// ── Quick assignment mode ─────────────────────────────────────────────────────
// Pure client-side: reveals the (already rendered) assignment selectors in every
// row. Re-applied after each render because Idiomorph restores the server HTML.
function applyQuickMode() {
    liveEl.querySelectorAll('.js-assign-form, .js-inline-assign-form').forEach(function (form) {
        const trigger = form.querySelector('.js-assign-trigger, .js-inline-trigger');
        const wrap    = form.querySelector('.js-assign-select, .js-inline-select-wrap');
        if (!trigger || !wrap) return;
        wrap.classList.toggle('hidden', !quickMode);
        trigger.classList.toggle('hidden', quickMode);
    });
    const btn = liveEl.querySelector('.js-quick-toggle');
    if (btn) {
        btn.setAttribute('aria-pressed', quickMode ? 'true' : 'false');
        btn.classList.toggle('bg-plum-600', quickMode);
        btn.classList.toggle('border-plum-600', quickMode);
        btn.classList.toggle('text-white', quickMode);
        btn.classList.toggle('bg-white', !quickMode);
        btn.classList.toggle('border-gray-300', !quickMode);
        btn.classList.toggle('text-gray-700', !quickMode);
    }
}

// ── Filtro «solo mis estudiantes» ─────────────────────────────────────────────
// Pura presentación en el cliente: oculta las filas de alumnado de otras enseñanzas y las
// cabeceras de grupo que se quedan vacías. Se reaplica tras cada render.
function applyMineOnly() {
    liveEl.querySelectorAll('tbody').forEach(function (tbody) {
        let header = null;
        let visible = 0;
        const closeHeader = function () {
            if (header) header.classList.toggle('hidden', (mineOnly || activeFilter !== null) && visible === 0);
        };
        tbody.querySelectorAll(':scope > tr').forEach(function (row) {
            if (row.classList.contains('table-group-header')) {
                closeHeader();
                header = row;
                visible = 0;
                return;
            }
            const hide = (mineOnly && row.dataset.mine === '0')
                || (activeFilter !== null && row.dataset.flags !== undefined && !row.dataset.flags.split(' ').includes(activeFilter));
            row.classList.toggle('hidden', hide);
            if (!hide) visible++;
        });
        closeHeader();
    });
    // Contadores y estado de los filtros rápidos
    liveEl.querySelectorAll('.js-filter-chip').forEach(function (chip) {
        const key = chip.dataset.filter;
        const n = liveEl.querySelectorAll('[data-flags]').length === 0 ? 0
            : Array.from(liveEl.querySelectorAll('tbody > tr[data-flags]')).filter(function (r) { return r.dataset.flags.split(' ').includes(key); }).length;
        chip.querySelector('.js-chip-count').textContent = String(n);
        const on = activeFilter === key;
        chip.classList.toggle('hidden', n === 0 && !on);
        chip.setAttribute('aria-pressed', on ? 'true' : 'false');
        chip.classList.toggle('bg-plum-600', on);
        chip.classList.toggle('border-plum-600', on);
        chip.classList.toggle('text-white', on);
        chip.classList.toggle('bg-white', !on);
        chip.classList.toggle('text-gray-600', !on);
    });
    const clear = liveEl.querySelector('.js-filter-clear');
    if (clear) clear.classList.toggle('hidden', activeFilter === null);
    const btn = liveEl.querySelector('.js-mine-toggle');
    if (btn) {
        btn.setAttribute('aria-pressed', mineOnly ? 'true' : 'false');
        btn.classList.toggle('bg-plum-600', mineOnly);
        btn.classList.toggle('border-plum-600', mineOnly);
        btn.classList.toggle('text-white', mineOnly);
        btn.classList.toggle('bg-white', !mineOnly);
        btn.classList.toggle('border-gray-300', !mineOnly);
        btn.classList.toggle('text-gray-700', !mineOnly);
    }
}

// ── Toast auto-dismiss ────────────────────────────────────────────────────────
function dismissToasts() {
    liveEl.querySelectorAll('.js-live-toast').forEach(function (toast) {
        if (toast.dataset.toastTimer) return;
        toast.dataset.toastTimer = '1';
        setTimeout(function () {
            toast.classList.add('opacity-0', 'transition-opacity', 'duration-300');
            setTimeout(function () { toast.remove(); }, 300);
        }, parseInt(toast.dataset.toastTtl || '3000', 10));
    });
}

function onRender() {
    initAllForms();
    applyQuickMode();
    applyMineOnly();
    dismissToasts();
}

liveEl = document.querySelector('.js-stay-detail');
if (liveEl) {
    getComponent(liveEl).then(function (component) {
        liveComp = component;
        setupEventDelegation();
        onRender();
        component.on('render:finished', onRender);
    });
}
</script>

</div>
