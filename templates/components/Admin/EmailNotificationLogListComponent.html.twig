{% import 'components/_pagination_live.html.twig' as pager %}

{% set pagination = this.pagination %}
{% set hasFilters = this.hasActiveFilters %}

<div {{ attributes }}>

    {# ── Panel de filtros ──────────────────────────────────────────────────── #}
    <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50 space-y-3">

        <div class="flex flex-wrap items-end gap-3">
            <div class="flex flex-col gap-1 min-w-56 flex-1">
                <label for="email-log-search" class="text-xs font-medium text-gray-500">{{ 'email_log.filter.search'|trans({}, 'admin') }}</label>
                <div class="relative">
                    <div class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-3">
                        {{ ux_icon('heroicons:magnifying-glass', {class: 'h-4 w-4 text-gray-400'}) }}
                    </div>
                    <input id="email-log-search" type="search"
                           data-model="debounce(300)|search"
                           value="{{ search }}"
                           placeholder="{{ 'email_log.filter.search_placeholder'|trans({}, 'admin') }}"
                           class="block w-full rounded-lg border border-gray-200 bg-white py-1.5 pl-9 pr-3 text-sm text-gray-900
                                  placeholder-gray-400 focus:border-plum-500 focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
                </div>
            </div>

            <div class="flex flex-col gap-1 min-w-44">
                <label for="email-log-event" class="text-xs font-medium text-gray-500">{{ 'email_log.filter.event'|trans({}, 'admin') }}</label>
                <select id="email-log-event" data-model="eventKey"
                        class="rounded-lg border border-gray-200 bg-white py-1.5 px-3 text-sm text-gray-900
                               focus:border-plum-500 focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
                    <option value="">{{ 'email_log.filter.all'|trans({}, 'admin') }}</option>
                    {% for key in this.distinctEventKeys %}
                        <option value="{{ key }}" {{ eventKey == key ? 'selected' }}>{{ ('email_log.event.' ~ key)|trans({}, 'admin') }}</option>
                    {% endfor %}
                </select>
            </div>

            <div class="flex flex-col gap-1 min-w-36">
                <label for="email-log-status" class="text-xs font-medium text-gray-500">{{ 'email_log.filter.status'|trans({}, 'admin') }}</label>
                <select id="email-log-status" data-model="status"
                        class="rounded-lg border border-gray-200 bg-white py-1.5 px-3 text-sm text-gray-900
                               focus:border-plum-500 focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
                    <option value="">{{ 'email_log.filter.all'|trans({}, 'admin') }}</option>
                    <option value="success" {{ status == 'success' ? 'selected' }}>{{ 'email_log.status.success'|trans({}, 'admin') }}</option>
                    <option value="failed" {{ status == 'failed' ? 'selected' }}>{{ 'email_log.status.failed'|trans({}, 'admin') }}</option>
                </select>
            </div>
        </div>

        <div class="flex flex-wrap items-end gap-3">
            <div class="flex flex-col gap-1 min-w-44">
                <label for="email-log-from" class="text-xs font-medium text-gray-500">{{ 'email_log.filter.from'|trans({}, 'admin') }}</label>
                <input id="email-log-from" type="datetime-local" data-model="dateFrom" value="{{ dateFrom }}"
                       class="rounded-lg border border-gray-200 bg-white py-1.5 px-3 text-sm text-gray-900
                              focus:border-plum-500 focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
            </div>
            <div class="flex flex-col gap-1 min-w-44">
                <label for="email-log-to" class="text-xs font-medium text-gray-500">{{ 'email_log.filter.to'|trans({}, 'admin') }}</label>
                <input id="email-log-to" type="datetime-local" data-model="dateTo" value="{{ dateTo }}"
                       class="rounded-lg border border-gray-200 bg-white py-1.5 px-3 text-sm text-gray-900
                              focus:border-plum-500 focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
            </div>
            <div class="flex flex-wrap gap-1.5 pb-0.5">
                {% for range in ['last_24h', 'last_week', 'last_month'] %}
                    <button type="button" data-action="live#action" data-live-action-param="quickRange" data-live-range-param="{{ range }}"
                            class="rounded-full border border-gray-200 bg-white px-3 py-1.5 text-xs font-medium text-gray-600
                                   hover:bg-plum-50 hover:border-plum-200 hover:text-plum-700 transition-colors">
                        {{ ('email_log.range.' ~ range)|trans({}, 'admin') }}
                    </button>
                {% endfor %}
            </div>
            <div class="flex items-center gap-2 pb-0.5">
                <svg data-loading class="hidden h-4 w-4 text-plum-500 animate-spin shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 22 6.477 22 12h-4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"/>
                </svg>
                {% if hasFilters %}
                    <button type="button" data-action="live#action" data-live-action-param="clearFilters"
                            class="inline-flex items-center gap-1.5 rounded-lg border border-gray-200 px-3 py-1.5 text-xs
                                   font-medium text-gray-600 hover:bg-gray-100 transition-colors shrink-0">
                        {{ ux_icon('heroicons:x-mark', {class: 'h-3.5 w-3.5'}) }}
                        {{ 'email_log.filter.clear'|trans({}, 'admin') }}
                    </button>
                {% endif %}
            </div>
        </div>
    </div>

    {# ── Tabla ─────────────────────────────────────────────────────────────── #}
    <div data-loading="addClass(opacity-50 pointer-events-none animate-pulse)" class="transition-opacity">

    {% if pagination.totalItems == 0 %}
        <div class="px-6 py-16 text-center">
            {{ ux_icon('heroicons:envelope', {class: 'mx-auto h-10 w-10 text-gray-300 mb-3'}) }}
            <p class="text-sm text-gray-500">
                {{ (hasFilters ? 'email_log.empty_filtered' : 'email_log.empty')|trans({}, 'admin') }}
            </p>
        </div>
    {% else %}
        <div class="overflow-x-auto">
        <table class="table-cards w-full text-sm">
            <thead>
                <tr class="border-b border-gray-100 bg-gray-50">
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.date'|trans({}, 'admin') }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.recipient'|trans({}, 'admin') }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.event'|trans({}, 'admin') }}</th>
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.subject'|trans({}, 'admin') }}</th>
                    {% if this.centre is null %}
                        <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.centre'|trans({}, 'admin') }}</th>
                    {% endif %}
                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">{{ 'email_log.col.status'|trans({}, 'admin') }}</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for entry in pagination.items %}
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td data-label="{{ 'email_log.col.date'|trans({}, 'admin') }}" class="px-6 py-3 whitespace-nowrap text-xs text-gray-700 font-mono">
                            {{ entry.sentAt|date('d/m/Y H:i:s') }}
                        </td>
                        <td data-label="{{ 'email_log.col.recipient'|trans({}, 'admin') }}" class="px-6 py-3">
                            <span class="font-medium text-gray-900 text-xs">{{ entry.recipientName }}</span>
                            <div class="text-xs text-gray-400">{{ entry.recipientEmail }}</div>
                        </td>
                        <td data-label="{{ 'email_log.col.event'|trans({}, 'admin') }}" class="px-6 py-3 whitespace-nowrap">
                            <span class="inline-flex items-center rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/20">
                                {{ ('email_log.event.' ~ entry.eventKey)|trans({}, 'admin') }}
                            </span>
                        </td>
                        <td data-label="{{ 'email_log.col.subject'|trans({}, 'admin') }}" class="px-6 py-3 text-xs text-gray-700">
                            {{ entry.subject }}
                        </td>
                        {% if this.centre is null %}
                            <td data-label="{{ 'email_log.col.centre'|trans({}, 'admin') }}" class="px-6 py-3 text-xs text-gray-700">
                                {% if entry.educationalCentre is not null %}{{ entry.educationalCentre.name }}{% else %}<span class="text-gray-300">—</span>{% endif %}
                            </td>
                        {% endif %}
                        <td data-label="{{ 'email_log.col.status'|trans({}, 'admin') }}" class="px-6 py-3">
                            {% if entry.success %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-green-50 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                                    {{ ux_icon('heroicons:check-circle', {class: 'h-3.5 w-3.5 shrink-0'}) }}
                                    {{ 'email_log.status.success'|trans({}, 'admin') }}
                                </span>
                            {% else %}
                                <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700 ring-1 ring-inset ring-red-600/20">
                                    {{ ux_icon('heroicons:x-circle', {class: 'h-3.5 w-3.5 shrink-0'}) }}
                                    {{ 'email_log.status.failed'|trans({}, 'admin') }}
                                </span>
                                {% if entry.errorMessage %}
                                    <div class="mt-1 max-w-xs truncate text-xs text-red-600" title="{{ entry.errorMessage }}">{{ entry.errorMessage }}</div>
                                {% endif %}
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>

        {{ pager.nav(pagination) }}
    {% endif %}
    </div>
</div>
