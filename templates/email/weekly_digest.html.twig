{% extends 'email/_layout.html.twig' %}

{% block content %}
    <p style="margin: 0 0 16px;">{{ 'emails.greeting'|trans({'%name%': recipient.name.firstName}, 'emails') }}</p>

    <p style="margin: 0 0 16px;">
        {{ 'emails.weekly_digest.intro'|trans({'%centre%': centre.name}, 'emails') }}
    </p>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 0 0 16px; font-size: 13px; border-collapse: collapse;">
        <tr>
            <th align="left" style="padding: 8px; border-bottom: 2px solid #e5e7eb; color: #6b7280; font-weight: bold;">{{ 'emails.weekly_digest.col.stay'|trans({}, 'emails') }}</th>
            <th align="left" style="padding: 8px; border-bottom: 2px solid #e5e7eb; color: #6b7280; font-weight: bold;">{{ 'emails.weekly_digest.col.pending'|trans({}, 'emails') }}</th>
        </tr>
        {% for item in items %}
            <tr>
                <td style="padding: 8px; border-bottom: 1px solid #f3f4f6;">{{ item.stay.name }}</td>
                <td style="padding: 8px; border-bottom: 1px solid #f3f4f6;">
                    <a href="{{ item.url }}" style="color: #6d28d9; text-decoration: none;">
                        {{ ('item.' ~ item.type)|trans({'%count%': item.count}, 'notifications') }}
                    </a>
                </td>
            </tr>
        {% endfor %}
    </table>

    <p style="margin: 0 0 16px; color: #6b7280;">{{ 'emails.weekly_digest.outro'|trans({}, 'emails') }}</p>
{% endblock %}
