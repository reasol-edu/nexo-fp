{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'data_review.title'|trans({}, 'admin') }} · {{ app_name }}{% endblock %}

{% block content %}
<div class="px-6 py-8 max-w-4xl mx-auto">

    <div class="mb-6">
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_educational_centre_index') }}" class="hover:text-plum-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'data_review.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">
            {{ 'data_review.subtitle'|trans({'%centre%': centre.name, '%year%': year ? year.name : '—'}, 'admin') }}
        </p>
    </div>

    {% set total = teachers_without_email|length + companies_without_workers|length + stays_with_drafts|length %}
    {% if total == 0 %}
        <div class="flex items-center gap-3 rounded-2xl border border-green-200 bg-green-50 px-5 py-4 text-sm text-green-800" role="status">
            {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 shrink-0 text-green-600'}) }}
            {{ 'data_review.all_good'|trans({}, 'admin') }}
        </div>
    {% endif %}

    <div class="space-y-6">

        {# ── Docentes sin correo ── #}
        {% if teachers_without_email is not empty %}
            <section class="rounded-2xl border border-amber-200 bg-white shadow-xs overflow-hidden" aria-labelledby="review-teachers">
                <div class="px-6 py-4 border-b border-amber-100 bg-amber-50">
                    <h2 id="review-teachers" class="text-base font-semibold text-amber-900">
                        {{ 'data_review.teachers.title'|trans({'%count%': teachers_without_email|length}, 'admin') }}
                    </h2>
                    <p class="mt-0.5 text-sm text-amber-800">{{ 'data_review.teachers.help'|trans({}, 'admin') }}</p>
                </div>
                <ul class="divide-y divide-gray-100">
                    {% for teacher in teachers_without_email %}
                        <li class="flex items-center justify-between gap-3 px-6 py-3 text-sm">
                            <span class="text-gray-900">{{ teacher.name.lastName }}, {{ teacher.name.firstName }}</span>
                            <a href="{{ path('app_admin_centre_teachers_index', {centreId: centre.id}) }}"
                               class="text-plum-600 hover:text-plum-800 font-medium">{{ 'data_review.teachers.fix'|trans({}, 'admin') }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# ── Empresas sin trabajadores ── #}
        {% if companies_without_workers is not empty %}
            <section class="rounded-2xl border border-amber-200 bg-white shadow-xs overflow-hidden" aria-labelledby="review-companies">
                <div class="px-6 py-4 border-b border-amber-100 bg-amber-50">
                    <h2 id="review-companies" class="text-base font-semibold text-amber-900">
                        {{ 'data_review.companies.title'|trans({'%count%': companies_without_workers|length}, 'admin') }}
                    </h2>
                    <p class="mt-0.5 text-sm text-amber-800">{{ 'data_review.companies.help'|trans({}, 'admin') }}</p>
                </div>
                <ul class="divide-y divide-gray-100">
                    {% for company in companies_without_workers %}
                        <li class="flex items-center justify-between gap-3 px-6 py-3 text-sm">
                            <span class="text-gray-900">{{ company.name }} <span class="text-gray-400">· {{ company.city }}</span></span>
                            <a href="{{ path('app_companies_edit', {id: company.id}) }}"
                               class="text-plum-600 hover:text-plum-800 font-medium">{{ 'data_review.companies.fix'|trans({}, 'admin') }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        {# ── Puestos en borrador con la estancia en marcha ── #}
        {% if stays_with_drafts is not empty %}
            <section class="rounded-2xl border border-amber-200 bg-white shadow-xs overflow-hidden" aria-labelledby="review-drafts">
                <div class="px-6 py-4 border-b border-amber-100 bg-amber-50">
                    <h2 id="review-drafts" class="text-base font-semibold text-amber-900">
                        {{ 'data_review.drafts.title'|trans({}, 'admin') }}
                    </h2>
                    <p class="mt-0.5 text-sm text-amber-800">{{ 'data_review.drafts.help'|trans({}, 'admin') }}</p>
                </div>
                <ul class="divide-y divide-gray-100">
                    {% for row in stays_with_drafts %}
                        <li class="flex items-center justify-between gap-3 px-6 py-3 text-sm">
                            <span class="text-gray-900">
                                {{ row.stay.name }}
                                <span class="text-gray-400">· {{ 'data_review.drafts.count'|trans({'%count%': row.drafts}, 'admin') }}</span>
                            </span>
                            <a href="{{ path('app_stays_show', {id: row.stay.id}) }}"
                               class="text-plum-600 hover:text-plum-800 font-medium">{{ 'data_review.drafts.fix'|trans({}, 'admin') }}</a>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

    </div>
</div>
{% endblock %}
