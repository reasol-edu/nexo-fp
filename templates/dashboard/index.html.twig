{% extends 'layouts/app.html.twig' %}
{% import 'dashboard/_parts.html.twig' as ui %}

{% block title %}{{ 'page_title'|trans({}, 'dashboard') }}{% endblock %}

{% block content %}
{% set active_centre  = active_centre() %}
{% set active_year    = active_centre ? active_centre.activeAcademicYear : null %}
{% set vy             = view_year() %}
{% set viewing_past   = is_viewing_past_year() %}
{% set view           = page ? page.view : null %}

<div class="px-6 py-8 max-w-7xl mx-auto space-y-8">

    {# ── Cabecera con el ámbito: qué datos se están viendo ───────────────────── #}
    <header class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="min-w-0">
            <h1 class="text-2xl font-bold text-gray-900">
                {{ 'greeting'|trans({'%name%': app.user.name.firstName}, 'dashboard') }}
            </h1>
            {% if vy %}
                <p class="mt-1 text-sm {{ viewing_past ? 'text-amber-700 font-medium' : 'text-gray-600' }}">
                    {{ 'scope.line'|trans({'%centre%': active_centre.name, '%year%': vy.name, '%date%': 'now'|date('d/m/Y')}, 'dashboard') }}
                </p>
            {% elseif active_year is null %}
                <p class="mt-1 text-sm text-amber-700">{{ 'no_academic_year'|trans({}, 'dashboard') }}</p>
            {% endif %}

            {% if view and not view.emptyScope %}
                {% set scope = view.scope %}
                <p class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-sm text-gray-600">
                    {% if scope.isAdmin %}<span>{{ 'scope.admin'|trans({}, 'dashboard') }}</span>{% endif %}
                    {% if not scope.isAdmin and scope.manageProgrammes is not empty %}
                        <span>{{ 'scope.manages'|trans({'%programmes%': scope.manageProgrammes|join(', ')}, 'dashboard') }}</span>
                    {% endif %}
                    {% if scope.groups is not empty %}
                        <span>{{ 'scope.teaches'|trans({'%groups%': scope.groups|map(g => g.name)|join(', ')}, 'dashboard') }}</span>
                    {% endif %}
                    {% if scope.companies is not empty %}
                        <span>{{ 'scope.liaison'|trans({'%count%': scope.companies|length}, 'dashboard') }}</span>
                    {% endif %}
                    {% if view.tutorships is not empty %}
                        <span>{{ 'scope.tutors'|trans({'%count%': view.tutorships|length}, 'dashboard') }}</span>
                    {% endif %}
                </p>
            {% endif %}
        </div>

        {# Una sola acción primaria, según lo que la persona puede hacer. #}
        {% if active_year and not viewing_past %}
            {% if is_granted('stay.create', active_centre) %}
                <a href="{{ path('app_stays_new') }}"
                   class="inline-flex min-h-11 self-start items-center gap-1.5 rounded-lg bg-plum-600 px-3.5 py-2 text-sm font-medium text-white shadow-xs hover:bg-plum-700 transition-colors sm:min-h-0 sm:self-auto">
                    {{ ux_icon('heroicons:plus', {class: 'h-4 w-4', 'aria-hidden': 'true'}) }}
                    {{ 'action_new_stay'|trans({}, 'dashboard') }}
                </a>
            {% elseif is_granted('company.section', active_centre) %}
                <a href="{{ path('app_companies_new') }}"
                   class="inline-flex min-h-11 self-start items-center gap-1.5 rounded-lg bg-plum-600 px-3.5 py-2 text-sm font-medium text-white shadow-xs hover:bg-plum-700 transition-colors sm:min-h-0 sm:self-auto">
                    {{ ux_icon('heroicons:building-office-2', {class: 'h-4 w-4', 'aria-hidden': 'true'}) }}
                    {{ 'action_new_company'|trans({}, 'dashboard') }}
                </a>
            {% endif %}
        {% endif %}
    </header>

    {% if view is null %}
        {# Sin curso académico activo #}
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-6 py-8 text-center">
            {{ ux_icon('heroicons:exclamation-triangle', {class: 'mx-auto mb-2 h-8 w-8 text-amber-500', 'aria-hidden': 'true'}) }}
            <p class="text-sm font-medium text-amber-900">{{ 'no_academic_year'|trans({}, 'dashboard') }}</p>
        </div>
    {% elseif view.emptyScope %}
        {# Sin responsabilidades: se explica en lugar de decir que todo está al día. #}
        <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-xs" aria-labelledby="empty-title">
            <h2 id="empty-title" class="text-base font-semibold text-gray-900">{{ 'empty_scope.title'|trans({}, 'dashboard') }}</h2>
            <p class="mt-2 max-w-3xl text-sm text-gray-600">{{ 'empty_scope.body'|trans({}, 'dashboard') }}</p>
            <p class="mt-4 flex flex-wrap gap-3 text-sm">
                <a href="{{ path('app_calendar') }}" class="font-medium text-plum-700 hover:underline">{{ 'milestones.calendar'|trans({}, 'dashboard') }} →</a>
                <a href="{{ path('app_profile') }}" class="font-medium text-plum-700 hover:underline">{{ 'empty_scope.profile'|trans({}, 'dashboard') }} →</a>
            </p>
        </section>
    {% else %}

    {% if viewing_past %}
        <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">{{ 'past_year'|trans({}, 'dashboard') }}</p>
    {% endif %}

    {# ── Atención ahora + próximos 30 días ─────────────────────────────────────── #}
    {% if not viewing_past %}
    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">

        <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs lg:col-span-2" aria-labelledby="attention-title">
            <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
                <h2 id="attention-title" class="flex items-center gap-2 text-sm font-semibold text-gray-800">
                    {{ ux_icon('heroicons:bell-alert', {class: 'h-4 w-4 text-amber-600', 'aria-hidden': 'true'}) }}
                    {{ 'attention.title'|trans({}, 'dashboard') }}
                </h2>
                {% if view.tasks is not empty %}
                    <span class="text-xs text-gray-600">{{ 'attention.count'|trans({'%count%': view.tasks|length}, 'dashboard') }}</span>
                {% endif %}
            </div>

            {% if view.tasks is empty %}
                <div class="flex items-center gap-2 px-5 py-8">
                    {{ ux_icon('heroicons:check-circle', {class: 'h-5 w-5 shrink-0 text-emerald-600', 'aria-hidden': 'true'}) }}
                    <p class="text-sm text-gray-600">{{ 'attention.clear'|trans({}, 'dashboard') }}</p>
                </div>
            {% else %}
                <ol class="divide-y divide-gray-100">
                    {% for task in view.tasks|slice(0, 6) %}
                        {% include 'dashboard/_task.html.twig' with {task: task} only %}
                    {% endfor %}
                </ol>
                {% if view.tasks|length > 6 %}
                    <details class="border-t border-gray-100">
                        <summary class="cursor-pointer px-5 py-3 text-sm font-medium text-plum-700 hover:bg-gray-50">
                            {{ 'attention.more'|trans({'%count%': view.tasks|length - 6}, 'dashboard') }}
                        </summary>
                        <ol class="divide-y divide-gray-100 border-t border-gray-100">
                            {% for task in view.tasks|slice(6) %}
                                {% include 'dashboard/_task.html.twig' with {task: task} only %}
                            {% endfor %}
                        </ol>
                    </details>
                {% endif %}
            {% endif %}
        </section>

        <section class="rounded-2xl border border-gray-200 bg-white shadow-xs" aria-labelledby="milestones-title">
            <div class="flex items-center justify-between gap-3 border-b border-gray-100 px-5 py-4">
                <h2 id="milestones-title" class="text-sm font-semibold text-gray-800">{{ 'milestones.title'|trans({}, 'dashboard') }}</h2>
                <a href="{{ path('app_calendar') }}" class="text-xs font-medium text-plum-700 hover:underline">{{ 'milestones.calendar'|trans({}, 'dashboard') }} →</a>
            </div>
            {% if view.milestones is empty %}
                <p class="px-5 py-6 text-sm text-gray-600">{{ 'milestones.empty'|trans({}, 'dashboard') }}</p>
            {% else %}
                <ol class="divide-y divide-gray-100">
                    {% for m in view.milestones|slice(0, 6) %}
                        <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-3 px-5 py-3">
                            <time datetime="{{ m.date|date('Y-m-d') }}" class="text-xs font-semibold text-plum-700 tabular-nums">{{ m.date|date('d/m') }}</time>
                            <a href="{{ path('app_stays_show', {id: m.stayId}) }}" class="min-w-0 text-sm text-gray-800 hover:text-plum-700">
                                {{ ('milestones.' ~ m.key)|trans({'%count%': m.count, '%stay%': m.stayName, '%subject%': m.subject ?? ''}, 'dashboard') }}
                            </a>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
        </section>

    </div>
    {% endif %}

    {# ── Mis estancias ─────────────────────────────────────────────────────────── #}
    {% if view.stays is not empty %}
    <section aria-labelledby="stays-title" class="space-y-3">
        <h2 id="stays-title" class="text-sm font-semibold text-gray-800">{{ 'stays.title'|trans({}, 'dashboard') }}</h2>

        {% if view.stays|length <= 6 %}
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                {% for card in view.stays %}
                    {% include 'dashboard/_stay_card.html.twig' with {card: card} only %}
                {% endfor %}
            </div>
        {% else %}
            {# Con muchas estancias, una tabla densa: se lee y se compara mejor que una pared de tarjetas. #}
            <div class="overflow-x-auto rounded-2xl border border-gray-200 bg-white shadow-xs">
                <table class="min-w-full text-sm">
                    <caption class="sr-only">{{ 'stays.title'|trans({}, 'dashboard') }}</caption>
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-600">
                            <th scope="col" class="px-4 py-2.5 font-medium">{{ 'stays.col.stay'|trans({}, 'dashboard') }}</th>
                            <th scope="col" class="px-4 py-2.5 font-medium">{{ 'stays.col.when'|trans({}, 'dashboard') }}</th>
                            {% for key in ['with_position', 'with_tutors', 'registered', 'signed'] %}
                                <th scope="col" class="px-4 py-2.5 text-right font-medium">{{ ('funnel.step.' ~ key)|trans({}, 'dashboard') }}</th>
                            {% endfor %}
                            <th scope="col" class="px-4 py-2.5 font-medium">{{ 'stays.col.next'|trans({}, 'dashboard') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for card in view.stays %}
                            <tr>
                                <th scope="row" class="px-4 py-3 text-left font-medium">
                                    <a href="{{ path('app_stays_show', {id: card.id}) }}" class="text-gray-900 underline decoration-gray-300 underline-offset-2 hover:text-plum-700 hover:decoration-plum-400">{{ card.name }}</a>
                                    <span class="block text-xs font-normal text-gray-600">{{ card.programmeNames }}</span>
                                </th>
                                <td class="px-4 py-3 text-xs text-gray-700">
                                    {% if card.worst %}{{ ui.severity(card.worst) }}<br>{% endif %}
                                    {{ ui.when(card.daysToStart) }}
                                </td>
                                {% for step in card.steps %}
                                    <td class="px-4 py-3 text-right tabular-nums text-gray-800">{{ step.done }}/{{ step.total }}</td>
                                {% endfor %}
                                <td class="px-4 py-3 text-xs text-plum-700">
                                    {% if card.next.filter %}
                                        <a href="{{ path('app_stays_show', {id: card.id, filtro: card.next.filter}) }}" class="hover:underline">{{ ('stays.progress.next_step.' ~ card.next.key)|trans({'%count%': card.next.count}, 'stays') }}</a>
                                    {% else %}
                                        {{ ('stays.progress.next_step.' ~ card.next.key)|trans({'%count%': card.next.count}, 'stays') }}
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endif %}
    </section>
    {% endif %}

    {# ── Mis tutorías (y reparto por docente) ──────────────────────────────────── #}
    {% if view.tutorships is not empty %}
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs" aria-labelledby="tutorships-title">
        <div class="border-b border-gray-100 px-5 py-4">
            <h2 id="tutorships-title" class="text-sm font-semibold text-gray-800">{{ 'tutorships.title'|trans({}, 'dashboard') }}</h2>
        </div>

        {% if view.workload is not empty %}
            <ul class="divide-y divide-gray-100 border-b border-gray-100 bg-gray-50/60">
                {% for w in view.workload %}
                    <li class="px-5 py-2.5 text-sm text-gray-700">
                        {{ 'workload.line'|trans({'%group%': w.groupName, '%stay%': w.stayName, '%expected%': w.expected, '%assigned%': w.assigned}, 'dashboard') }}
                        {% if w.assigned < w.expected %}
                            <span class="font-medium text-amber-800">· {{ 'stays.teachers.missing'|trans({'%count%': w.expected - w.assigned}, 'stays') }}</span>
                        {% elseif w.assigned > w.expected %}
                            <span class="font-medium text-red-700">· {{ 'stays.teachers.extra'|trans({'%count%': w.assigned - w.expected}, 'stays') }}</span>
                        {% else %}
                            <span class="font-medium text-emerald-700">· {{ 'stays.teachers.complete'|trans({}, 'stays') }}</span>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}

        <ul class="divide-y divide-gray-100">
            {% for row in view.tutorships %}
                <li class="grid grid-cols-1 gap-1 px-5 py-3 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)_minmax(0,1.2fr)] sm:items-center sm:gap-4">
                    <div class="min-w-0">
                        <p class="truncate text-sm font-medium text-gray-900">{{ page.studentNames[row.studentId] ?? '—' }}</p>
                        <p class="truncate text-xs text-gray-600">{{ row.workcenterId ? (page.workcenterLabels[row.workcenterId] ?? '—') : ('tutorships.no_workcenter'|trans({}, 'dashboard')) }}</p>
                    </div>
                    <p class="text-xs text-gray-600">
                        <a href="{{ path('app_stays_show', {id: row.stayId}) }}" class="hover:text-plum-700">{{ row.stayName }}</a><br>
                        {{ row.start|date('d/m/Y') }} – {{ row.end|date('d/m/Y') }}
                    </p>
                    <div class="flex flex-wrap items-center gap-2 text-sm">
                        {% set stage = row.state.value == 'DONE' ? (row.signed ? 4 : 3) : (row.state.value == 'PENDING' ? 2 : 1) %}
                        <span class="inline-flex gap-0.5" aria-hidden="true">
                            {% for i in 1..4 %}<i class="block h-1.5 w-4 rounded-full {{ i <= stage ? 'bg-plum-600' : 'bg-gray-200' }}"></i>{% endfor %}
                        </span>
                        {% if row.severity %}{{ ui.severity(row.severity) }}{% endif %}
                        <span class="text-gray-800">{{ ('tutorships.action.' ~ row.action)|trans({'%date%': row.start|date('d/m/Y')}, 'dashboard') }}</span>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {# ── Mis empresas (docente de enlace) ──────────────────────────────────────── #}
    {% if view.companies is not empty %}
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs" aria-labelledby="companies-title">
        <div class="border-b border-gray-100 px-5 py-4">
            <h2 id="companies-title" class="text-sm font-semibold text-gray-800">{{ 'companies.title'|trans({}, 'dashboard') }}</h2>
        </div>
        <ul class="divide-y divide-gray-100">
            {% for row in view.companies %}
                <li class="flex flex-col gap-1 px-5 py-3 sm:flex-row sm:items-center sm:gap-4">
                    <div class="min-w-0 sm:flex-1">
                        <a href="{{ path('app_companies_edit', {id: row.companyId}) }}" class="text-sm font-medium text-gray-900 hover:text-plum-700">{{ row.name }}</a>
                        {% if row.withoutWorkers %}
                            <p class="mt-0.5 inline-flex items-center gap-1 text-xs font-medium text-amber-800">
                                {{ ux_icon('heroicons:exclamation-triangle', {class: 'h-3.5 w-3.5', 'aria-hidden': 'true'}) }}
                                {{ 'companies.without_workers'|trans({}, 'dashboard') }}
                            </p>
                        {% endif %}
                    </div>
                    <p class="text-xs text-gray-700">
                        {{ 'companies.positions'|trans({'%free%': row.freePositions, '%assigned%': row.assignedPositions}, 'dashboard') }}
                        {% if row.nextStart %} · {{ 'companies.next_start'|trans({'%date%': row.nextStart|date('d/m/Y')}, 'dashboard') }}{% endif %}
                    </p>
                </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {# ── Mi grupo (tutor/a o docente de grupo) ─────────────────────────────────── #}
    {% if view.groups is not empty %}
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs" aria-labelledby="groups-title">
        <div class="border-b border-gray-100 px-5 py-4">
            <h2 id="groups-title" class="text-sm font-semibold text-gray-800">{{ 'groups.title'|trans({}, 'dashboard') }}</h2>
        </div>
        <ul class="divide-y divide-gray-100">
            {% for row in view.groups %}
                <li class="px-5 py-3">
                    <p class="text-sm font-medium text-gray-900">
                        {{ row.name }}
                        <span class="ml-2 text-xs font-normal text-gray-600">{{ 'groups.summary'|trans({'%placed%': row.withPosition, '%total%': row.students}, 'dashboard') }}</span>
                    </p>
                    {% if row.withoutPositionTotal > 0 %}
                        <p class="mt-1 text-xs text-gray-700">
                            {{ 'groups.without_position'|trans({'%count%': row.withoutPositionTotal}, 'dashboard') }}:
                            {{ row.withoutPositionIds|map(id => page.studentNames[id] ?? '—')|join(', ') }}{% if row.withoutPositionTotal > row.withoutPositionIds|length %}…{% endif %}
                            {% if row.stayId %}<a href="{{ path('app_stays_show', {id: row.stayId, filtro: 'sin-puesto'}) }}" class="ml-1 font-medium text-plum-700 hover:underline">{{ 'attention.action.view'|trans({}, 'dashboard') }} →</a>{% endif %}
                        </p>
                    {% endif %}
                </li>
            {% endfor %}
        </ul>
    </section>
    {% endif %}

    {# ── Avance del proceso ─────────────────────────────────────────────────────── #}
    {% if view.funnel is not empty %}
    <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs" aria-labelledby="funnel-title">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <h2 id="funnel-title" class="text-sm font-semibold text-gray-800">{{ 'funnel.title'|trans({}, 'dashboard') }}</h2>
            <nav class="flex flex-wrap gap-1.5 text-xs" aria-label="{{ 'funnel.mode.label'|trans({}, 'dashboard')|e('html_attr') }}">
                {% for mode in ['activas', 'proximas', 'todas'] %}
                    <a href="{{ path('app_dashboard', {avance: mode}) }}"
                       class="rounded-full border px-3 py-1.5 {{ view.funnelMode == mode ? 'border-plum-600 bg-plum-600 text-white' : 'border-gray-200 bg-white text-gray-700 hover:border-plum-300' }}"
                       {% if view.funnelMode == mode %}aria-current="true"{% endif %}>
                        {{ ('funnel.mode.' ~ mode)|trans({}, 'dashboard') }}
                    </a>
                {% endfor %}
            </nav>
        </div>
        <div class="mt-4 grid max-w-2xl gap-2">
            {% for step in view.funnel %}
                {{ ui.meter(('funnel.step.' ~ step.key)|trans({}, 'dashboard'), step.done, step.total, loop.index0) }}
            {% endfor %}
        </div>
    </section>
    {% endif %}

    {# ── Cobertura por enseñanza (jefatura y dirección) ─────────────────────────── #}
    {% if view.coverage is not empty %}
    <section class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-xs" aria-labelledby="coverage-title">
        <div class="border-b border-gray-100 px-5 py-4">
            <h2 id="coverage-title" class="text-sm font-semibold text-gray-800">{{ 'coverage.title'|trans({}, 'dashboard') }}</h2>
            <p class="mt-0.5 text-xs text-gray-600">{{ 'coverage.intro'|trans({}, 'dashboard') }}</p>
        </div>
        <div class="overflow-x-auto" tabindex="0" role="region" aria-label="{{ 'coverage.title'|trans({}, 'dashboard')|e('html_attr') }}">
            <table class="min-w-full text-sm">
                <caption class="sr-only">{{ 'coverage.title'|trans({}, 'dashboard') }}</caption>
                <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 text-left text-xs uppercase tracking-wide text-gray-600">
                        <th scope="col" class="px-4 py-2.5 font-medium">{{ 'coverage.col.programme'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 text-right font-medium">{{ 'coverage.col.students'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 text-right font-medium">{{ 'coverage.col.without'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 font-medium">{{ 'funnel.step.with_tutors'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 font-medium">{{ 'funnel.step.registered'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 font-medium">{{ 'funnel.step.signed'|trans({}, 'dashboard') }}</th>
                        <th scope="col" class="px-4 py-2.5 font-medium">{{ 'coverage.col.risk'|trans({}, 'dashboard') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    {% for row in view.coverage %}
                        <tr>
                            <th scope="row" class="px-4 py-3 text-left font-medium text-gray-900">
                                {{ row.programmeName }}
                                <span class="block text-xs font-normal text-gray-600">{{ row.familyName }}</span>
                            </th>
                            <td class="px-4 py-3 text-right tabular-nums text-gray-800">{{ row.students }}</td>
                            <td class="px-4 py-3 text-right tabular-nums {{ row.withoutPosition > 0 ? 'font-semibold text-gray-900' : 'text-gray-600' }}">{{ row.withoutPosition }}</td>
                            {% for done in [row.bothTutors, row.registered, row.signed] %}
                                {% set pct = row.students > 0 ? ((done / row.students) * 100)|round : 0 %}
                                <td class="px-4 py-3">
                                    <span class="tabular-nums text-gray-800">{{ done }}/{{ row.students }}</span>
                                    <div class="mt-1 h-1 w-20 rounded-full bg-gray-100" aria-hidden="true"><div class="h-full rounded-full bg-plum-500" style="width: {{ pct }}%"></div></div>
                                </td>
                            {% endfor %}
                            <td class="px-4 py-3">
                                {% if row.risk %}{{ ui.severity(row.risk) }}{% else %}<span class="text-xs font-medium text-emerald-700">{{ 'coverage.ok'|trans({}, 'dashboard') }}</span>{% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
    {% endif %}

    {# ── Datos por completar (dirección) ────────────────────────────────────────── #}
    {% if page.review and (page.review.teachersWithoutEmail or page.review.companiesWithoutWorkers or page.review.staysWithDrafts or page.review.failedEmails) %}
    <section class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs" aria-labelledby="review-title">
        <h2 id="review-title" class="text-sm font-semibold text-gray-800">{{ 'review.title'|trans({}, 'dashboard') }}</h2>
        <ul class="mt-3 grid gap-2 text-sm">
            {% if page.review.teachersWithoutEmail %}
                <li><a href="{{ path('app_educational_centre_data_review') }}" class="text-gray-800 hover:text-plum-700">{{ 'review.teachers_without_email'|trans({'%count%': page.review.teachersWithoutEmail}, 'dashboard') }} →</a></li>
            {% endif %}
            {% if page.review.companiesWithoutWorkers %}
                <li><a href="{{ path('app_educational_centre_data_review') }}" class="text-gray-800 hover:text-plum-700">{{ 'review.companies_without_workers'|trans({'%count%': page.review.companiesWithoutWorkers}, 'dashboard') }} →</a></li>
            {% endif %}
            {% if page.review.staysWithDrafts %}
                <li><a href="{{ path('app_educational_centre_data_review') }}" class="text-gray-800 hover:text-plum-700">{{ 'review.stays_with_drafts'|trans({'%count%': page.review.staysWithDrafts}, 'dashboard') }} →</a></li>
            {% endif %}
            {% if page.review.failedEmails %}
                <li><a href="{{ path('app_educational_centre_email_log') }}" class="text-gray-800 hover:text-plum-700">{{ 'review.failed_emails'|trans({'%count%': page.review.failedEmails}, 'dashboard') }} →</a></li>
            {% endif %}
        </ul>
    </section>
    {% endif %}

    {# ── Finalizadas ─────────────────────────────────────────────────────────────── #}
    {% if view.finished %}
        <p class="text-sm text-gray-600">
            {{ 'finished.line'|trans({'%count%': view.finished.count, '%percent%': view.finished.signedPercent}, 'dashboard') }}
            <a href="{{ path('app_stays_index') }}" class="ml-1 font-medium text-plum-700 hover:underline">{{ 'finished.link'|trans({}, 'dashboard') }} →</a>
        </p>
    {% endif %}

    {% endif %}
</div>
{% endblock %}
