{# Piezas del inicio: gravedad con icono y texto (nunca solo color), plazos y medidores. #}

{# Etiqueta de gravedad: icono + texto, para que no dependa del color. #}
{% macro severity(level) %}
    {% if level.value == 'critical' %}
        <span class="inline-flex items-center gap-1 rounded-full bg-red-50 px-2 py-0.5 text-xs font-semibold text-red-700">
            {{ ux_icon('heroicons:exclamation-triangle', {class: 'h-3.5 w-3.5 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'attention.level.critical'|trans({}, 'dashboard') }}
        </span>
    {% elseif level.value == 'soon' %}
        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-semibold text-amber-800">
            {{ ux_icon('heroicons:clock', {class: 'h-3.5 w-3.5 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'attention.level.soon'|trans({}, 'dashboard') }}
        </span>
    {% else %}
        <span class="inline-flex items-center gap-1 rounded-full bg-blue-50 px-2 py-0.5 text-xs font-semibold text-blue-800">
            {{ ux_icon('heroicons:information-circle', {class: 'h-3.5 w-3.5 shrink-0', 'aria-hidden': 'true'}) }}
            {{ 'attention.level.info'|trans({}, 'dashboard') }}
        </span>
    {% endif %}
{% endmacro %}

{# «Empezó hace 46 días» / «empieza hoy» / «empieza en 12 días». #}
{% macro when(days) %}
    {%- if days < 0 -%}
        {{ 'attention.when.started'|trans({'%count%': -days}, 'dashboard') }}
    {%- elseif days == 0 -%}
        {{ 'attention.when.today'|trans({}, 'dashboard') }}
    {%- else -%}
        {{ 'attention.when.future'|trans({'%count%': days}, 'dashboard') }}
    {%- endif -%}
{% endmacro %}

{# Medidor «etiqueta · barra · n/N». El tono baja de intensidad etapa a etapa (son etapas ordenadas, no categorías). #}
{% macro meter(label, done, total, step) %}
    {% set pct = total > 0 ? ((done / total) * 100)|round : 0 %}
    {% set tones = ['bg-plum-700', 'bg-plum-600', 'bg-plum-500', 'bg-plum-400'] %}
    <div class="grid grid-cols-[5.5rem_minmax(0,1fr)_3rem] items-center gap-2 text-xs">
        <span class="truncate text-gray-600">{{ label }}</span>
        <div class="h-2 rounded-full bg-gray-100" role="progressbar" aria-valuemin="0" aria-valuemax="{{ total }}" aria-valuenow="{{ done }}"
             aria-label="{{ label|e('html_attr') }}: {{ done }}/{{ total }}">
            <div class="h-full rounded-full {{ tones[step|default(0)] ?? 'bg-plum-500' }}" style="width: {{ pct }}%"></div>
        </div>
        <span class="text-right tabular-nums text-gray-700">{{ done }}/{{ total }}</span>
    </div>
{% endmacro %}
