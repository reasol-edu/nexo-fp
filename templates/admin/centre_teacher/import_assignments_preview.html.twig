{% extends 'layouts/app.html.twig' %}

{% block title %}{{ 'centre_teachers.import_assignments.preview.title'|trans({}, 'admin') }} · {{ centre.name }} · {{ app_name }}{% endblock %}

{% block content %}
{% set count_new     = plan|filter(r => r.status == 'new')|length %}
{% set count_same    = plan|filter(r => r.status == 'existing')|length %}
{% set count_teacher = plan|filter(r => r.status == 'unknown_teacher')|length %}
{% set count_group   = plan|filter(r => r.status == 'unknown_group')|length %}
<div class="px-6 py-8 max-w-4xl mx-auto space-y-8">

    <div>
        <div class="flex items-center gap-2 text-sm text-gray-500 mb-1 flex-wrap">
            {% include 'components/_breadcrumb_home.html.twig' %}
            <a href="{{ path('app_educational_centre_index') }}" class="hover:text-plum-600 transition-colors">{{ 'educational_centre'|trans({}, 'navigation') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_admin_centre_teachers_index', {centreId: centre.id}) }}" class="hover:text-plum-600 transition-colors">{{ 'centre_teachers.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
            <a href="{{ path('app_admin_centre_teachers_import_assignments', {centreId: centre.id}) }}" class="hover:text-plum-600 transition-colors">{{ 'centre_teachers.import_assignments.title'|trans({}, 'admin') }}</a>
            {{ ux_icon('heroicons:chevron-right', {class: 'h-4 w-4 shrink-0'}) }}
        </div>
        <h1 class="text-2xl font-bold text-gray-900">{{ 'centre_teachers.import_assignments.preview.title'|trans({}, 'admin') }}</h1>
        <p class="mt-1 text-sm text-gray-500">{{ centre.activeAcademicYear.name }}</p>
    </div>

    <form method="post"
          action="{{ path('app_admin_centre_teachers_import_assignments', {centreId: centre.id}) }}"
          data-controller="form-submit"
          id="assignments-import-form"
          class="space-y-6">
        <input type="hidden" name="import_confirmed" value="1">
        <input type="hidden" name="import_id" value="{{ importId }}">
        <input type="hidden" name="_token" value="{{ csrf_token('import_teacher_assignments_confirm') }}">

        {# ── Resumen ─────────────────────────────────────────────────────── #}
        <div class="flex flex-wrap gap-2 text-sm">
            <span class="inline-flex items-center rounded-full bg-green-50 border border-green-200 px-3 py-1 font-medium text-green-800">{{ 'centre_teachers.import_assignments.preview.count_new'|trans({'%count%': count_new}, 'admin') }}</span>
            <span class="inline-flex items-center rounded-full bg-gray-50 border border-gray-200 px-3 py-1 text-gray-600">{{ 'centre_teachers.import_assignments.preview.count_same'|trans({'%count%': count_same}, 'admin') }}</span>
            {% if count_teacher > 0 %}
                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-3 py-1 font-medium text-amber-800">{{ 'centre_teachers.import_assignments.preview.count_unknown_teacher'|trans({'%count%': count_teacher}, 'admin') }}</span>
            {% endif %}
            {% if count_group > 0 %}
                <span class="inline-flex items-center rounded-full bg-amber-50 border border-amber-200 px-3 py-1 font-medium text-amber-800">{{ 'centre_teachers.import_assignments.preview.count_unknown_group'|trans({'%count%': count_group}, 'admin') }}</span>
            {% endif %}
            {% if skipped > 0 %}
                <span class="inline-flex items-center rounded-full bg-gray-50 border border-gray-200 px-3 py-1 text-gray-600">{{ 'centre_teachers.import_assignments.preview.count_skipped'|trans({'%count%': skipped}, 'admin') }}</span>
            {% endif %}
        </div>

        {# ── Asignaciones del fichero ───────────────────────────────────── #}
        <div class="rounded-2xl border border-gray-200 bg-white shadow-xs overflow-hidden">
            <div class="px-6 py-4 border-b border-gray-100 flex flex-wrap items-center gap-3">
                <h2 class="text-base font-semibold text-gray-900 mr-auto">{{ 'centre_teachers.import_assignments.preview.assignments'|trans({}, 'admin') }}</h2>
                <span class="text-xs text-gray-500" id="selected-count" aria-live="polite"></span>
                <div class="flex items-center gap-3 shrink-0">
                    <button type="button" class="js-select-all text-xs font-medium text-plum-600 hover:text-plum-800">{{ 'centre_teachers.import_assignments.preview.select_all'|trans({}, 'admin') }}</button>
                    <button type="button" class="js-select-none text-xs font-medium text-plum-600 hover:text-plum-800">{{ 'centre_teachers.import_assignments.preview.select_none'|trans({}, 'admin') }}</button>
                </div>
            </div>

            {% if plan is empty %}
                <p class="px-6 py-10 text-center text-sm text-gray-500">{{ 'centre_teachers.import_assignments.preview.empty'|trans({}, 'admin') }}</p>
            {% else %}
            <div class="overflow-x-auto">
                <table class="min-w-full text-sm">
                    <thead>
                        <tr class="border-b border-gray-100 bg-gray-50/50 text-left text-xs font-medium uppercase tracking-wide text-gray-500">
                            <th scope="col" class="px-4 py-3 w-10"><span class="sr-only">{{ 'centre_teachers.import_assignments.preview.col_select'|trans({}, 'admin') }}</span></th>
                            <th scope="col" class="px-4 py-3">{{ 'centre_teachers.import_assignments.preview.col_group'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-4 py-3">{{ 'centre_teachers.import_assignments.preview.col_teacher'|trans({}, 'admin') }}</th>
                            <th scope="col" class="px-4 py-3">{{ 'centre_teachers.import_assignments.preview.col_action'|trans({}, 'admin') }}</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {% for row in plan %}
                            <tr class="hover:bg-gray-50/60 {{ row.actionable ? '' : 'text-gray-500' }}">
                                <td class="px-4 py-2.5">
                                    <input type="checkbox" name="assignments[]" value="{{ row.key }}"
                                           {{ row.actionable ? 'checked' : 'disabled' }}
                                           aria-label="{{ row.groupName }} · {{ row.teacherName }}"
                                           class="h-4 w-4 rounded border-gray-300 text-plum-600 focus:ring-plum-500">
                                </td>
                                <td class="px-4 py-2.5 font-medium {{ row.actionable ? 'text-gray-900' : '' }}">{{ row.groupName }}</td>
                                <td class="px-4 py-2.5">{{ row.teacherName }}</td>
                                <td class="px-4 py-2.5 text-xs">
                                    {% if row.status == 'new' %}
                                        <span class="inline-flex rounded-full bg-green-50 px-2 py-0.5 font-medium text-green-700">{{ 'centre_teachers.import_assignments.preview.action_new'|trans({}, 'admin') }}</span>
                                    {% elseif row.status == 'existing' %}
                                        <span>{{ 'centre_teachers.import_assignments.preview.action_existing'|trans({}, 'admin') }}</span>
                                    {% elseif row.status == 'unknown_teacher' %}
                                        <span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 font-medium text-amber-800">{{ 'centre_teachers.import_assignments.preview.action_unknown_teacher'|trans({}, 'admin') }}</span>
                                    {% else %}
                                        <span class="inline-flex rounded-full bg-amber-50 px-2 py-0.5 font-medium text-amber-800">{{ 'centre_teachers.import_assignments.preview.action_unknown_group'|trans({}, 'admin') }}</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
            {% endif %}
        </div>

        <div class="flex items-center justify-between pt-2">
            <a href="{{ path('app_admin_centre_teachers_import_assignments', {centreId: centre.id}) }}"
               class="text-sm text-gray-500 hover:text-gray-700 transition-colors">
                {{ 'centre_teachers.import_assignments.preview.back'|trans({}, 'admin') }}
            </a>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-plum-600 px-4 py-2.5 text-sm font-semibold text-white hover:bg-plum-700 transition-colors shadow-xs">
                {{ ux_icon('heroicons:check', {class: 'h-4 w-4'}) }}
                {{ 'centre_teachers.import_assignments.preview.confirm'|trans({}, 'admin') }}
            </button>
        </div>
    </form>
</div>

<script>
(function () {
    const form = document.getElementById('assignments-import-form');
    const counter = document.getElementById('selected-count');
    const T_SELECTED = '{{ 'centre_teachers.import_assignments.preview.selected'|trans({}, 'admin')|e('js') }}';

    // Solo las filas con algo que hacer tienen la casilla activa.
    const boxes = () => Array.from(form.querySelectorAll('input[type="checkbox"][name="assignments[]"]')).filter((b) => !b.disabled);

    function refreshCount() {
        const all = boxes();
        counter.textContent = T_SELECTED.replace('%selected%', all.filter((b) => b.checked).length).replace('%total%', all.length);
    }

    form.addEventListener('click', (e) => {
        const all = e.target.closest('.js-select-all');
        const btn = all || e.target.closest('.js-select-none');
        if (!btn) return;
        boxes().forEach((b) => { b.checked = !!all; });
        refreshCount();
    });
    form.addEventListener('change', (e) => { if (e.target.matches('input[name="assignments[]"]')) refreshCount(); });
    refreshCount();
})();
</script>
{% endblock %}
