{# Preferencia de una enseñanza sobre el puesto hasta una fecha (solo en estancias con varias enseñanzas).
   Variables: stay, values.priority_programme_id, values.priority_until, errors, locked (opcional). #}
{% if stay.programmes|length > 1 %}
<div>
    <span class="block text-sm font-medium text-gray-700 mb-1">
        {{ 'stays.position.field.priority'|trans({}, 'stays') }}
        <span class="text-gray-400 font-normal">({{ 'stays.position.optional'|trans({}, 'stays') }})</span>
    </span>
    <p class="mb-2 text-xs text-gray-500">{{ 'stays.position.field.priority_hint'|trans({}, 'stays') }}</p>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div>
            <label for="priority_programme_id" class="block text-xs font-medium text-gray-600 mb-1">
                {{ 'stays.position.field.priority_programme'|trans({}, 'stays') }}
            </label>
            <select id="priority_programme_id" name="priority_programme_id"
                    {{ locked|default(false) ? 'disabled' : '' }}
                    class="block w-full rounded-xl border py-2.5 px-3.5 text-sm text-gray-900
                           {{ errors.priority_programme_id is defined ? 'border-red-300 bg-red-50' : 'border-gray-200 bg-gray-50' }}
                           focus:border-plum-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
                <option value="">{{ 'stays.position.field.priority_none'|trans({}, 'stays') }}</option>
                {% for programme in stay.programmesSorted %}
                    <option value="{{ programme.id.toRfc4122 }}" {{ values.priority_programme_id == programme.id.toRfc4122 ? 'selected' : '' }}>
                        {{ programme.name }}
                    </option>
                {% endfor %}
            </select>
            {% if errors.priority_programme_id is defined %}
                <p class="mt-1 text-xs text-red-600">{{ errors.priority_programme_id }}</p>
            {% endif %}
        </div>
        <div>
            <label for="priority_until" class="block text-xs font-medium text-gray-600 mb-1">
                {{ 'stays.position.field.priority_until'|trans({}, 'stays') }}
            </label>
            <input id="priority_until" type="date" name="priority_until"
                   value="{{ values.priority_until }}"
                   {{ locked|default(false) ? 'disabled' : '' }}
                   class="block w-full rounded-xl border py-2.5 px-3.5 text-sm text-gray-900
                          {{ errors.priority_until is defined ? 'border-red-300 bg-red-50' : 'border-gray-200 bg-gray-50' }}
                          focus:border-plum-500 focus:bg-white focus:outline-none focus:ring-3 focus:ring-plum-500/20 transition-colors">
            {% if errors.priority_until is defined %}
                <p class="mt-1 text-xs text-red-600">{{ errors.priority_until }}</p>
            {% endif %}
        </div>
    </div>
</div>
{% endif %}
