{# Selector múltiple de los niveles de la estancia, agrupados por enseñanza (y familia profesional): una estancia
   puede incluir solo 2.º de una enseñanza. Cada grupo ofrece «Toda la enseñanza» para marcar todos sus niveles.
   Variables: by_family, values.programme_year_ids, errors.programme_year_ids, locked_ids (opcional). #}
{% set locked_ids = locked_ids|default([]) %}
<div>
    <label for="programme_year_ids" class="block text-sm font-medium text-gray-700 mb-1.5">
        {{ 'stays.field.programmes'|trans({}, 'stays') }}
        <span class="text-red-400 ml-0.5">*</span>
    </label>
    <select id="programme_year_ids" name="programme_year_ids[]" multiple
            data-ts-has-error="{{ errors.programme_year_ids is defined ? '1' : '' }}"
            data-locked="{{ locked_ids|join(',') }}"
            data-all-label="{{ 'stays.field.programmes_all'|trans({}, 'stays')|e('html_attr') }}"
            class="w-full text-sm">
        {% for group in by_family %}
            {% for p in group.programmes %}
                {% if p.programmeYears is not empty %}
                    <optgroup label="{{ p.name }}" data-family="{{ group.family.name }}">
                        {% for level in p.programmeYears %}
                            <option value="{{ level.id }}" {{ level.id.toRfc4122 in values.programme_year_ids ? 'selected' : '' }}>
                                {{ level.name }}
                            </option>
                        {% endfor %}
                    </optgroup>
                {% endif %}
            {% endfor %}
        {% endfor %}
    </select>
    <p class="mt-1.5 text-xs text-gray-500">{{ 'stays.field.programmes_hint'|trans({}, 'stays') }}</p>
    {% if locked_ids is not empty %}
        <p class="mt-1 text-xs text-gray-500">{{ 'stays.field.programmes_locked_hint'|trans({}, 'stays') }}</p>
    {% endif %}
    {% if errors.programme_year_ids is defined %}
        <p class="mt-1.5 text-xs text-red-600">{{ errors.programme_year_ids }}</p>
    {% endif %}
</div>

<script type="module">
import TomSelect from 'tom-select';

const el = document.getElementById('programme_year_ids');
if (el) {

const locked = (el.dataset.locked || '').split(',').filter(Boolean);
const selected = Array.from(el.selectedOptions).map(o => o.value);
const allLabel = el.dataset.allLabel || '';

// Opciones y grupos para que la búsqueda encuentre por nivel, enseñanza y familia
const options   = [];
const optgroups = [];

el.querySelectorAll('optgroup').forEach((og, i) => {
    const gid = String(i);
    optgroups.push({ id: gid, label: og.label, family: og.dataset.family || '' });
    og.querySelectorAll('option').forEach(opt => {
        options.push({
            value: opt.value,
            text:  opt.textContent.trim(),
            optgroup: gid,
            search: og.dataset.family + ' ' + og.label + ' ' + opt.textContent.trim(),
        });
    });
});

const ts = new TomSelect(el, {
    dropdownParent:     'body',   // que no lo recorte el contenedor
    options,
    items:              selected,
    optgroups,
    valueField:         'value',
    labelField:         'text',
    optgroupField:      'optgroup',
    optgroupValueField: 'id',
    optgroupLabelField: 'label',
    searchField:        ['text', 'search'],
    create:             false,
    maxOptions:         null,
    hidePlaceholder:    true,
    closeAfterSelect:   false,
    placeholder:        '{{ 'stays.field.programmes_placeholder'|trans({}, 'stays')|e('js') }}',
    wrapperClass:       'ts-wrapper ts-local',
    plugins:            ['remove_button'],
    // Los niveles con alumnado o puestos no se pueden quitar de la estancia
    onDelete:           (values) => !values.some(v => locked.includes(String(v))),
    render: {
        optgroup_header: (d, esc) => `<div class="optgroup-header flex items-center justify-between gap-2">`
            + `<span><span class="font-semibold">${esc(d.label)}</span>${d.family ? ` <span class="text-gray-400 font-normal">· ${esc(d.family)}</span>` : ''}</span>`
            + `<button type="button" data-select-group="${esc(d.id)}" class="rounded-md border border-gray-200 bg-white px-1.5 py-0.5 text-[11px] font-medium text-plum-700 hover:bg-plum-50">${esc(allLabel)}</button>`
            + `</div>`,
        option:     (d, esc) => `<div class="py-0.5">${esc(d.text)}</div>`,
        item:       (d, esc) => `<div>${esc(optgroupLabel(d))} · ${esc(d.text)}</div>`,
        no_results: () => `<div class="no-results px-3 py-2 text-sm">{{ 'stays.field.programme_no_results'|trans({}, 'stays')|e('js') }}</div>`,
    },
});

// La etiqueta de un nivel elegido incluye su enseñanza («DAW · 2.º DAW»)
function optgroupLabel(d) {
    const g = optgroups.find(o => o.id === d.optgroup);
    return g ? g.label : '';
}

// «Toda la enseñanza»: marca de una vez todos los niveles del grupo
ts.dropdown.addEventListener('mousedown', (e) => {
    const button = e.target.closest('[data-select-group]');
    if (!button) return;
    e.preventDefault();
    e.stopPropagation();
    options.filter(o => o.optgroup === button.dataset.selectGroup).forEach(o => ts.addItem(o.value, true));
    ts.refreshState();
    ts.refreshOptions(false);
});

if (el.dataset.tsHasError) {
    ts.wrapper.classList.add('has-error');
}

} // end if (el)
</script>
