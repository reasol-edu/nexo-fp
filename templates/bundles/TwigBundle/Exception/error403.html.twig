<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso denegado · Nexo FP</title>
    <link rel="icon" type="image/svg+xml" href="{{ asset('static/favicon.svg') }}">
    <link rel="shortcut icon" href="{{ asset('static/favicon.ico') }}">
    <link rel="stylesheet" href="{{ asset('fonts/inter/inter.css') }}">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --plum-300: #bfadd8;
            --plum-400: #a38dc5;
            --plum-500: #876baf;
            --plum-600: #67597a;
            --plum-700: #574a68;
            --plum-800: #453a54;
            --plum-900: #362d42;
            --plum-950: #1f192a;
            --amber-400: #fbbf24;
            --amber-300: #fcd34d;
        }

        html, body { height: 100%; }

        body {
            font-family: 'Inter', ui-sans-serif, system-ui, sans-serif;
            background: var(--plum-950);
            color: white;
            overflow: hidden;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
        }

        /* ── Parallax orbs ────────────────────────────────────────────────── */
        .orb {
            position: fixed;
            border-radius: 50%;
            pointer-events: none;
            will-change: transform;
        }
        .orb-a { width: 460px; height: 460px; top: -130px; right: -130px; background: rgba(255,255,255,0.02); }
        .orb-b { width: 260px; height: 260px; top: 40%; right: -50px;    background: rgba(103,89,122,0.25); }
        .orb-c { width: 340px; height: 340px; bottom: -90px; left: -90px; background: rgba(255,255,255,0.018); }
        .orb-d { width: 100px; height: 100px; top: 15%;    left: 6%;     background: rgba(191,173,216,0.12); }

        /* ── Content ──────────────────────────────────────────────────────── */
        .page {
            position: relative;
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 2rem 1.5rem;
        }

        /* ── Shield with repulsion effect ────────────────────────────────── */
        .shield-scene {
            position: relative;
            width: 200px;
            height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* Concentric ripple rings that pulse outward */
        .ring {
            position: absolute;
            border-radius: 50%;
            border: 1px solid rgba(163, 141, 197, 0.3);
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation: ring-expand 3s ease-out infinite;
            pointer-events: none;
        }
        .ring:nth-child(1) { animation-delay: 0s;   }
        .ring:nth-child(2) { animation-delay: 1s;   }
        .ring:nth-child(3) { animation-delay: 2s;   }

        @keyframes ring-expand {
            0%   { width:  72px; height:  72px; opacity: 0.9; }
            100% { width: 250px; height: 250px; opacity: 0;   }
        }

        .shield-icon {
            position: relative;
            z-index: 10;
            width: 88px;
            height: 88px;
            color: var(--plum-400);
            will-change: transform;
            transition: filter 0.2s ease;
            filter: drop-shadow(0 0 14px rgba(135,107,175,0.3));
            animation: shield-idle 6s ease-in-out infinite;
        }

        @keyframes shield-idle {
            0%, 100% { transform: translateY(0)    scale(1);    }
            50%       { transform: translateY(-6px) scale(1.02); }
        }

        /* Glow that intensifies as mouse approaches */
        .shield-glow {
            position: absolute;
            inset: -20px;
            border-radius: 50%;
            background: radial-gradient(circle at center, rgba(163,141,197,0.35) 0%, transparent 65%);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
        }

        /* ── Error code badge ─────────────────────────────────────────────── */
        .code-badge {
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: var(--plum-500);
            text-transform: uppercase;
            margin-bottom: 0.25rem;
        }

        /* ── Typography ───────────────────────────────────────────────────── */
        .title {
            margin-top: 1.75rem;
            font-size: clamp(1.2rem, 3vw, 1.6rem);
            font-weight: 700;
            letter-spacing: -0.02em;
            color: white;
        }

        .subtitle {
            margin-top: 0.625rem;
            font-size: 1rem;
            line-height: 1.65;
            color: var(--plum-400);
            max-width: 26rem;
        }

        /* ── Actions ──────────────────────────────────────────────────────── */
        .actions {
            margin-top: 2.5rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            justify-content: center;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: var(--plum-600);
            color: white;
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 600;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            text-decoration: none;
            border: none;
            cursor: pointer;
            transition: background 0.15s, transform 0.15s, box-shadow 0.2s;
        }
        .btn-primary:hover {
            background: var(--plum-700);
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(103,89,122,0.5);
        }
        .btn-primary:active { transform: translateY(0); }

        .btn-ghost {
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            background: transparent;
            color: var(--plum-400);
            font-family: inherit;
            font-size: 0.875rem;
            font-weight: 500;
            padding: 0.75rem 1.5rem;
            border-radius: 0.75rem;
            border: 1px solid var(--plum-800);
            text-decoration: none;
            cursor: pointer;
            transition: color 0.15s, border-color 0.15s, transform 0.15s;
        }
        .btn-ghost:hover {
            color: var(--plum-300);
            border-color: var(--plum-600);
            transform: translateY(-1px);
        }

        @media (prefers-reduced-motion: reduce) {
            .ring { animation: none; }
            .shield-icon { animation: none; }
            .btn-primary:hover, .btn-ghost:hover { transform: none; }
        }
    </style>
</head>
<body>
    <div class="orb orb-a" data-speed="30"></div>
    <div class="orb orb-b" data-speed="50"></div>
    <div class="orb orb-c" data-speed="36"></div>
    <div class="orb orb-d" data-speed="65"></div>

    <main class="page">
        <div class="shield-scene" id="shield-scene">
            <div class="ring"></div>
            <div class="ring"></div>
            <div class="ring"></div>
            <div class="shield-glow" id="shield-glow"></div>
            <!-- Heroicons shield-exclamation (outline) -->
            <svg class="shield-icon" id="shield-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>

        <p class="code-badge">Error 403</p>
        <h1 class="title">Acceso denegado</h1>
        <p class="subtitle">No tienes permiso para acceder a esta sección. Si crees que es un error, contacta con el administrador.</p>

        <div class="actions">
            <button type="button" onclick="history.back()" class="btn-primary">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18"/>
                </svg>
                Volver atrás
            </button>
            <a href="/" class="btn-ghost">
                <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25"/>
                </svg>
                Ir al inicio
            </a>
        </div>
    </main>

    <script>
    (function () {
        var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var orbs   = document.querySelectorAll('.orb[data-speed]');
        var shield = document.getElementById('shield-icon');
        var glow   = document.getElementById('shield-glow');
        var scene  = document.getElementById('shield-scene');

        var tx = 0, ty = 0, cx = 0, cy = 0;   // orb lerp targets
        var sx = 0, sy = 0, scx = 0, scy = 0; // shield lerp targets

        document.addEventListener('mousemove', function (e) {
            tx = e.clientX / window.innerWidth  - 0.5;
            ty = e.clientY / window.innerHeight - 0.5;

            if (!reducedMotion) {
                var rect  = scene.getBoundingClientRect();
                var midX  = rect.left + rect.width  / 2;
                var midY  = rect.top  + rect.height / 2;
                var dx    = e.clientX - midX;
                var dy    = e.clientY - midY;
                var dist  = Math.sqrt(dx * dx + dy * dy);
                var reach = 220;

                if (dist < reach) {
                    var force = Math.pow(1 - dist / reach, 1.5) * 40;
                    var ang   = Math.atan2(dy, dx);
                    sx = -Math.cos(ang) * force;
                    sy = -Math.sin(ang) * force;
                    glow.style.opacity = (1 - dist / reach) * 0.85;
                } else {
                    sx = 0; sy = 0;
                    glow.style.opacity = 0;
                }
            }
        });

        (function tick() {
            if (!reducedMotion) {
                cx  += (tx  - cx)  * 0.06;
                cy  += (ty  - cy)  * 0.06;
                scx += (sx  - scx) * 0.10;
                scy += (sy  - scy) * 0.10;

                orbs.forEach(function (o) {
                    var s = +o.dataset.speed;
                    o.style.transform = 'translate(' + (cx*s).toFixed(1) + 'px,' + (cy*s).toFixed(1) + 'px)';
                });
                shield.style.transform = 'translate(' + scx.toFixed(1) + 'px,' + scy.toFixed(1) + 'px)';
            }
            requestAnimationFrame(tick);
        }());
    }());
    </script>
</body>
</html>
